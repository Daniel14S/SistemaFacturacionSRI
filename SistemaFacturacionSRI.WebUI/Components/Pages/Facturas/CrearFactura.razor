@code {
// ==================== VARIABLES ====================
private CrearFacturaViewModel modelo = new();
private ClienteListDto? clienteSeleccionado;
private List<ClienteListDto> clientesBuscados = new();
private List<ProductoDto> productosDisponibles = new();
private bool cargandoInicial = true;
private bool guardando = false;
private bool buscandoClientes = false;
private string terminoBusquedaCliente = string.Empty;
private System.Threading.Timer? debounceTimer;


// ==================== INICIALIZACIÓN ====================
protected override async Task OnInitializedAsync()
{
    await CargarDatosIniciales();
}

private async Task CargarDatosIniciales()
{
    cargandoInicial = true;
    try
    {
        productosDisponibles = await ProductoService.ObtenerTodosAsync();
        productosDisponibles = productosDisponibles.Where(p => p.Activo && p.Stock > 0).ToList();
    }
    catch (Exception ex)
    {
        Toast.ShowError($"Error al cargar datos: {ex.Message}");
    }
    finally
    {
        cargandoInicial = false;
    }
}



private async Task BuscarProductoIncremental(int index, string termino)
{
    if (index < 0 || index >= modelo.Detalles.Count) return;

    var detalle = modelo.Detalles[index];
    detalle.BusquedaProducto = termino;

    if (string.IsNullOrWhiteSpace(termino))
    {
        detalle.ResultadosBusqueda.Clear();
        return;
    }

    // Limpiar término para búsqueda flexible
    var terminoLimpio = termino.Replace("-", "").Replace(" ", "").ToLower();

    // Buscar con priorización
    var resultados = productosDisponibles
        .Where(p => p.Stock > 0)
        .Where(p => 
            // Código completo
            p.Codigo.Contains(termino, StringComparison.OrdinalIgnoreCase) ||
            // Código limpio (sin guiones/espacios)
            p.Codigo.Replace("-", "").Replace(" ", "")
                .Contains(terminoLimpio, StringComparison.OrdinalIgnoreCase) ||
            // Nombre
            p.Nombre.Contains(termino, StringComparison.OrdinalIgnoreCase)
        )
        .OrderBy(p => 
            // Priorizar coincidencias exactas de código
            p.Codigo.Equals(termino, StringComparison.OrdinalIgnoreCase) ? 0 :
            p.Codigo.StartsWith(termino, StringComparison.OrdinalIgnoreCase) ? 1 : 2
        )
        .ThenBy(p => p.Nombre)
        .Take(10)
        .ToList();

    detalle.ResultadosBusqueda = resultados;
    StateHasChanged();
}




// ==================== BÚSQUEDA DE CLIENTES ====================
private void BuscarClientesIncremental(ChangeEventArgs e)
{
    terminoBusquedaCliente = e.Value?.ToString() ?? string.Empty;

    if (string.IsNullOrWhiteSpace(terminoBusquedaCliente))
    {
        clientesBuscados.Clear();
        return;
    }

    debounceTimer?.Dispose();
    debounceTimer = new System.Threading.Timer(async _ =>
    {
        await InvokeAsync(async () =>
        {
            await BuscarClientesAsync();
            StateHasChanged();
        });
    }, null, 300, Timeout.Infinite);
}

private async Task BuscarClientesAsync()
{
    if (string.IsNullOrWhiteSpace(terminoBusquedaCliente)) return;

    buscandoClientes = true;
    try
    {
        clientesBuscados = await ClienteService.BuscarClientesAsync(terminoBusquedaCliente, 10);
    }
    catch (Exception ex)
    {
        Toast.ShowError($"Error al buscar clientes: {ex.Message}");
        clientesBuscados.Clear();
    }
    finally
    {
        buscandoClientes = false;
    }
}

private async Task SeleccionarCliente(ClienteListDto cliente)
{
    try
    {
        var clienteCompleto = await ClienteService.ObtenerPorIdAsync(cliente.ClienteId);
        if (clienteCompleto == null) return;

        modelo.ClienteId = clienteCompleto.ClienteId;
        modelo.ClienteNombre = clienteCompleto.NombreCompleto;
        modelo.ClienteIdentificacion = clienteCompleto.Identificacion;
        clienteSeleccionado = cliente;

        terminoBusquedaCliente = string.Empty;
        clientesBuscados.Clear();
        Toast.ShowSuccess($"Cliente seleccionado: {clienteCompleto.NombreCompleto}");
    }
    catch (Exception ex)
    {
        Toast.ShowError($"Error: {ex.Message}");
    }
}

private void DeseleccionarCliente()
{
    clienteSeleccionado = null;
    modelo.ClienteId = 0;
}

private void LimpiarBusquedaCliente()
{
    terminoBusquedaCliente = string.Empty;
    clientesBuscados.Clear();
}

// ==================== GESTIÓN DE DETALLES ====================
private void AgregarNuevoDetalle()
{
    if (clienteSeleccionado == null) return;
    modelo.AgregarDetalle();
}

private void EliminarDetalle(int index)
{
    if (index < 0 || index >= modelo.Detalles.Count) return;
    modelo.EliminarDetalle(modelo.Detalles[index]);
    modelo.RecalcularTotales();
}

// Convierte cantidad decimal a int para mostrar en el input
private int ConvertToIntForInput(decimal cantidad)
{
    // Si tu modelo ya usa int, reemplaza esto.
    var val = (int)Math.Max(1, Math.Floor((double)cantidad));
    return val;
}

// Maneja cambio de cantidad desde el input (forzar entero y validar stock)
private void OnCantidadChanged(int index, ChangeEventArgs e)
{
    if (index < 0 || index >= modelo.Detalles.Count) return;
    var detalle = modelo.Detalles[index];

    if (!int.TryParse(e.Value?.ToString(), out int newCantidad))
    {
        Toast.ShowWarning("Cantidad inválida. Use un número entero.");
        return;
    }

    if (newCantidad < 1)
    {
        Toast.ShowWarning("La cantidad mínima es 1.");
        detalle.Cantidad = 1;
    }
    else if (detalle.ProductoStock > 0 && newCantidad > detalle.ProductoStock)
    {
        Toast.ShowWarning($"Cantidad supera el stock disponible ({detalle.ProductoStock}). Se ajustará al stock.");
        detalle.Cantidad = detalle.ProductoStock;
    }
    else
    {
        detalle.Cantidad = newCantidad;
    }

    RecalcularDetalle(index);
}


private void SeleccionarProducto(int index, int productoId)
{
    if (productoId == 0 || index >= modelo.Detalles.Count) return;

    var detalle = modelo.Detalles[index];
    var producto = productosDisponibles.FirstOrDefault(p => p.Id == productoId);

    if (producto == null)
    {
        Toast.ShowError("Producto no encontrado");
        return;
    }

    if (producto.Stock <= 0)
    {
        Toast.ShowWarning($"El producto '{producto.Nombre}' no tiene stock disponible");
        return;
    }

    // Asigna datos
    detalle.ProductoId = producto.Id;
    detalle.ProductoNombre = producto.Nombre;
    detalle.ProductoCodigo = producto.Codigo;
    detalle.ProductoPrecio = producto.Precio ?? 0m;
    detalle.PrecioUnitario = producto.Precio ?? 0m;
    detalle.ProductoStock = producto.Stock;
    detalle.Cantidad = 1;
    detalle.CodigoPorcentajeIVA = 4; // Código SRI para IVA 15%

    // 🆕 Limpia resultados para ocultar la lista
    detalle.ResultadosBusqueda.Clear();
    detalle.BusquedaProducto = "";

    RecalcularDetalle(index);

    Toast.ShowSuccess($"Producto '{producto.Nombre}' agregado");
}


private void RecalcularDetalle(int index)
{
    if (index >= modelo.Detalles.Count) return;

    // Asegurar cantidad entera >=1
    var detalle = modelo.Detalles[index];
    detalle.Cantidad = Math.Max(1, (decimal)Math.Floor((double)detalle.Cantidad));

    // No permitir descuento mayor al subtotal (precio * cantidad)
    var subtotalSinDescuento = detalle.PrecioUnitario * detalle.Cantidad;
    if (detalle.Descuento > subtotalSinDescuento)
    {
        detalle.Descuento = subtotalSinDescuento;
        Toast.ShowWarning("El descuento no puede ser mayor al subtotal. Se ajustó automáticamente.");
    }

    // Validar stock
    if (detalle.ProductoStock > 0 && detalle.Cantidad > detalle.ProductoStock)
    {
        detalle.Cantidad = detalle.ProductoStock;
        Toast.ShowWarning($"Cantidad ajustada al stock disponible ({detalle.ProductoStock}).");
    }

    // Llamar a los métodos del ViewModel para recalcular (si existen)
    try
    {
        detalle.RecalcularTotales();
    }
    catch
    {
        // Si tu Detalle no tiene RecalcularTotales, aplica una versión básica:
        detalle.ValorTotal = (detalle.PrecioUnitario * detalle.Cantidad) - detalle.Descuento;
    }

    modelo.RecalcularTotales();
    StateHasChanged();
}

// ==================== GUARDADO ====================
private async Task GuardarBorrador()
{
    await GuardarFacturaAsync(false);
}

private async Task GenerarYEnviarSri()
{
    await GuardarFacturaAsync(true);
}

private bool ValidarAntesDeEnviar(out string mensaje)
{
    mensaje = string.Empty;

    if (modelo.ClienteId <= 0)
    {
        mensaje = "Seleccione un cliente.";
        return false;
    }

    if (!modelo.Detalles.Any(d => d.ProductoId > 0))
    {
        mensaje = "Agregue al menos un producto.";
        return false;
    }

    for (int i = 0; i < modelo.Detalles.Count; i++)
    {
        var d = modelo.Detalles[i];
        if (d.ProductoId == 0) continue;

        // Cantidad >= 1 y entero
        var cantidadEntera = (int)Math.Floor((double)d.Cantidad);
        if (cantidadEntera < 1)
        {
            mensaje = $"La cantidad en la línea {i + 1} debe ser al menos 1.";
            return false;
        }

        if (d.ProductoStock > 0 && cantidadEntera > d.ProductoStock)
        {
            mensaje = $"La cantidad en la línea {i + 1} supera el stock disponible ({d.ProductoStock}).";
            return false;
        }

        // Descuento <= precio * cantidad
        var subtotal = d.PrecioUnitario * cantidadEntera;
        if (d.Descuento > subtotal)
        {
            mensaje = $"El descuento en la línea {i + 1} no puede ser mayor que el subtotal (${subtotal:N2}).";
            return false;
        }
    }

    return true;
}

private async Task GuardarFacturaAsync(bool enviarSri)
{
    if (!modelo.EsValida())
    {
        Toast.ShowError("Complete todos los campos requeridos");
        return;
    }

    if (!ValidarAntesDeEnviar(out var validacionMsg))
    {
        Toast.ShowError(validacionMsg);
        return;
    }

    guardando = true;
    try
    {
        var dto = new CrearFacturaDto
        {
            ClienteId = modelo.ClienteId,
            Observaciones = modelo.Observaciones,
            Detalles = modelo.Detalles.Where(d => d.ProductoId > 0)
                .Select(d => new CrearDetalleFacturaDto
                {
                    ProductoId = d.ProductoId,
                    Cantidad = (int)Math.Floor((double)d.Cantidad),
                    PrecioUnitario = d.PrecioUnitario,
                    Descuento = d.Descuento,
                    CodigoPorcentajeIVA = d.CodigoPorcentajeIVA
                }).ToList()
        };

        var response = await FacturaService.CrearFacturaAsync(dto);

        if (response == null)
        {
            Toast.ShowError("Error al comunicarse con el servidor");
            return;
        }

        if (response.Factura == null)
        {
            Toast.ShowError(response.Message ?? "Error al crear la factura");
            return;
        }

        Toast.ShowSuccess($"Factura {response.Factura.NumeroFactura} creada exitosamente");

        if (enviarSri)
        {
            Toast.ShowInfo("Firmando y enviando al SRI...");
            await EnviarFacturaAlSri(response.Factura.Id);
        }
        else
        {
            Navigation.NavigateTo($"/facturas/{response.Factura.Id}");
        }
    }
    catch (HttpRequestException ex)
    {
        Toast.ShowError($"Error de conexión: {ex.Message}");
    }
    catch (Exception ex)
    {
        Toast.ShowError($"Error inesperado: {ex.Message}");
    }
    finally
    {
        guardando = false;
    }
}

private async Task EnviarFacturaAlSri(int facturaId)
{
    try
    {
        var resultadoFirma = await FacturaService.FirmarFacturaAsync(facturaId);

        if (resultadoFirma == null || string.IsNullOrEmpty(resultadoFirma.EstadoActual))
        {
            Toast.ShowError("Error al firmar la factura");
            Navigation.NavigateTo($"/facturas/{facturaId}");
            return;
        }

        Toast.ShowSuccess("Factura firmada exitosamente");

        Toast.ShowInfo("Enviando al SRI...");
        var enviado = await FacturaService.ReenviarSriAsync(facturaId);

        if (enviado)
        {
            Toast.ShowSuccess("Factura enviada al SRI. Consulte el estado en el detalle.");
        }
        else
        {
            Toast.ShowWarning("La factura fue creada pero hubo un problema al enviar al SRI");
        }

        Navigation.NavigateTo($"/facturas/{facturaId}");
    }
    catch (Exception ex)
    {
        Toast.ShowError($"Error al procesar: {ex.Message}");
        Navigation.NavigateTo($"/facturas/{facturaId}");
    }
}

