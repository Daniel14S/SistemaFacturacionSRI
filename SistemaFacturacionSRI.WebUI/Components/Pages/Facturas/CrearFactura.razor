@* SistemaFacturacionSRI.WebUI/Components/Pages/Facturas/CrearFactura.razor *@
@page "/crearfactura"
@using SistemaFacturacionSRI.WebUI.Models.Facturacion
@using SistemaFacturacionSRI.WebUI.Services
@using SistemaFacturacionSRI.Domain.DTOs.Factura
@using SistemaFacturacionSRI.Domain.DTOs.Producto
@using SistemaFacturacionSRI.Domain.DTOs.Cliente
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOrVendedor")]
@inject IFacturaHttpService FacturaService
@inject IClienteHttpService ClienteService
@inject IProductoHttpService ProductoService
@inject NavigationManager Navigation
@inject ToastService Toast
@rendermode InteractiveServer

<PageTitle>Crear Factura - Sistema de Facturación</PageTitle>

<style>
    .pos-container {
        display: flex;
        height: calc(100vh - 100px);
        gap: 0;
        margin: -15px;
        overflow: hidden;
    }

    .pos-left-panel {
        flex: 0 0 65%;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        overflow-y: auto;
    }

    .pos-search-bar {
        display: flex;
        gap: 10px;
    }

    .pos-search-bar input {
        flex-grow: 1;
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 16px;
    }

    .pos-products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 15px;
        overflow-y: auto;
        padding-right: 5px;
    }

    .pos-product-card {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .pos-product-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        border-color: var(--bs-primary);
    }

    .pos-product-icon {
        font-size: 2.5rem;
        margin-bottom: 8px;
        display: block;
    }

    .pos-product-name {
        display: block;
        font-weight: 500;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }

    .pos-product-price {
        color: var(--bs-primary);
        font-weight: bold;
        font-size: 1.1rem;
    }

    .pos-product-stock {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 5px;
    }

    .pos-right-panel {
        flex: 0 0 35%;
        background-color: white;
        border-left: 2px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        box-shadow: -4px 0 15px rgba(0,0,0,0.05);
    }

    .pos-cart-header {
        padding: 20px;
        background: linear-gradient(135deg, var(--bs-primary) 0%, #1e40af 100%);
        color: white;
        font-size: 1.3rem;
        font-weight: bold;
    }

    .pos-cart-items {
        flex-grow: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .pos-cart-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

    .pos-cart-item-info {
        flex-grow: 1;
    }

    .pos-cart-item-name {
        font-weight: 500;
        margin-bottom: 2px;
    }

    .pos-cart-item-price {
        font-size: 0.85rem;
        color: #64748b;
    }

    .pos-cart-item-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .pos-qty-btn {
        width: 28px;
        height: 28px;
        padding: 0;
        border: 1px solid #e2e8f0;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pos-qty-btn:hover {
        background: #f8fafc;
    }

    .pos-qty-display {
        min-width: 40px;
        text-align: center;
        font-weight: 600;
    }

    .pos-cart-footer {
        padding: 20px;
        background-color: #f8fafc;
        border-top: 2px solid #e2e8f0;
    }

    .pos-client-info {
        margin-bottom: 15px;
    }

    .pos-client-info label {
        display: block;
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .pos-client-info input {
        width: 100%;
        padding: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        font-size: 0.95rem;
    }

    .pos-totals-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 0.95rem;
        color: #475569;
    }

    .pos-total-final {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1e293b;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 2px solid #e2e8f0;
    }

    .pos-btn-cobrar {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        margin-top: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.2s;
    }

    .pos-btn-cobrar:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .pos-btn-cobrar:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
    }

    .pos-empty-cart {
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
    }

    .pos-btn-delete {
        background: #ef4444;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 4px 8px;
        cursor: pointer;
        font-size: 0.85rem;
    }

    .pos-btn-delete:hover {
        background: #dc2626;
    }

    .pos-selected-client {
        background: #f0f9ff;
        border: 2px solid #3b82f6;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .pos-selected-client-name {
        font-weight: 600;
        color: #1e40af;
        margin-bottom: 4px;
    }

    .pos-selected-client-id {
        font-size: 0.85rem;
        color: #64748b;
    }

    .pos-btn-change-client {
        font-size: 0.8rem;
        padding: 4px 10px;
        margin-top: 8px;
    }
</style>

@if (cargandoInicial)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-3">Cargando información inicial...</p>
    </div>
}
else
{
    <div class="pos-container">
        <!-- ==================== PANEL IZQUIERDO: PRODUCTOS ==================== -->
        <div class="pos-left-panel">
            <!-- Barra de búsqueda de productos -->
            <div class="pos-search-bar">
                <input type="text" 
                       placeholder="🔍 Buscar producto por nombre o código..."
                       value="@terminoBusquedaProducto"
                       @oninput="@(e => { terminoBusquedaProducto = e.Value?.ToString() ?? string.Empty; FiltrarProductos(); })"
                       class="form-control" />
                @if (!string.IsNullOrWhiteSpace(terminoBusquedaProducto))
                {
                    <button class="btn btn-outline-secondary" @onclick="LimpiarBusquedaProducto">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>

            <!-- Grid de productos -->
            <div class="pos-products-grid">
                @if (productosFiltrados.Any())
                {
                    @foreach (var producto in productosFiltrados)
                    {
                        <div class="pos-product-card" @onclick="() => AgregarProductoAlCarrito(producto.Id)">
                            <span class="pos-product-icon">📦</span>
                            <span class="pos-product-name">@producto.Nombre</span>
                            <span class="pos-product-price">$@producto.Precio?.ToString("N2")</span>
                            <small class="pos-product-stock">Stock: @producto.Stock</small>
                        </div>
                    }
                }
                else
                {
                    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #94a3b8;">
                        <i class="bi bi-inbox" style="font-size: 3rem; display: block; margin-bottom: 10px;"></i>
                        @if (string.IsNullOrWhiteSpace(terminoBusquedaProducto))
                        {
                            <p>No hay productos disponibles</p>
                        }
                        else
                        {
                            <p>No se encontraron productos con "<strong>@terminoBusquedaProducto</strong>"</p>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ==================== PANEL DERECHO: CARRITO ==================== -->
        <div class="pos-right-panel">
            <!-- Header del carrito -->
            <div class="pos-cart-header">
                <i class="bi bi-cart3 me-2"></i>Carrito de Compra
            </div>

            <!-- Items del carrito -->
            <div class="pos-cart-items">
                @if (modelo.Detalles.Any(d => d.ProductoId > 0))
                {
                    @foreach (var detalle in modelo.Detalles.Where(d => d.ProductoId > 0))
                    {
                        var index = modelo.Detalles.IndexOf(detalle);
                        <div class="pos-cart-item">
                            <div class="pos-cart-item-info">
                                <div class="pos-cart-item-name">@detalle.ProductoNombre</div>
                                <div class="pos-cart-item-price">$@detalle.PrecioUnitario.ToString("N2") x @((int)detalle.Cantidad)</div>
                            </div>
                            <div class="pos-cart-item-actions">
                                <button type="button" class="pos-qty-btn" @onclick="() => DisminuirCantidad(index)">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <span class="pos-qty-display">@((int)detalle.Cantidad)</span>
                                <button type="button" class="pos-qty-btn" @onclick="() => AumentarCantidad(index)">
                                    <i class="bi bi-plus"></i>
                                </button>
                                <button type="button" class="pos-btn-delete" @onclick="() => EliminarDetalle(index)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="pos-empty-cart">
                        <i class="bi bi-cart-x" style="font-size: 4rem; display: block; margin-bottom: 15px;"></i>
                        <p>El carrito está vacío</p>
                        <small>Selecciona productos del panel izquierdo</small>
                    </div>
                }
            </div>

            <!-- Footer: Cliente y Totales -->
            <div class="pos-cart-footer">
                <!-- Información del Cliente -->
                <div class="pos-client-info">
                    <label>Cliente:</label>
                    @if (clienteSeleccionado == null)
                    {
                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Buscar cliente por nombre o RUC/Cédula..."
                                   @bind="terminoBusquedaCliente"
                                   @oninput="BuscarClientesIncremental" />
                            @if (!string.IsNullOrWhiteSpace(terminoBusquedaCliente))
                            {
                                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LimpiarBusquedaCliente">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>

                        <!-- Resultados de búsqueda de clientes -->
                        @if (clientesBuscados.Any())
                        {
                            <div class="list-group mt-2" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var cliente in clientesBuscados)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action text-start"
                                            style="font-size: 0.9rem; padding: 8px 12px;"
                                            @onclick="() => SeleccionarCliente(cliente)">
                                        <strong>@cliente.NombreCompleto</strong><br />
                                        <small class="text-muted">@cliente.TipoIdentificacion: @cliente.Identificacion</small>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pos-selected-client">
                            <div class="pos-selected-client-name">
                                <i class="bi bi-person-check-fill me-2"></i>@clienteSeleccionado.NombreCompleto
                            </div>
                            <div class="pos-selected-client-id">
                                @clienteSeleccionado.TipoIdentificacion: @clienteSeleccionado.Identificacion
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm pos-btn-change-client" @onclick="DeseleccionarCliente">
                                <i class="bi bi-arrow-left-right me-1"></i>Cambiar cliente
                            </button>
                        </div>
                    }
                </div>

                <!-- Totales -->
                <div class="pos-totals-row">
                    <span>Subtotal:</span>
                    <span>$@modelo.Subtotal15.ToString("N2")</span>
                </div>
                <div class="pos-totals-row">
                    <span>IVA (15%):</span>
                    <span>$@modelo.TotalIVA.ToString("N2")</span>
                </div>
                <div class="pos-totals-row pos-total-final">
                    <span>Total:</span>
                    <span>$@modelo.Total.ToString("N2")</span>
                </div>

                <!-- Botones de acción -->
                <button type="button" 
                        class="pos-btn-cobrar" 
                        @onclick="GenerarYEnviarSri"
                        disabled="@(guardando || clienteSeleccionado == null || !modelo.Detalles.Any(d => d.ProductoId > 0))">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Procesando...</span>
                    }
                    else
                    {
                        <i class="bi bi-receipt me-2"></i>
                        <span>GENERAR FACTURA</span>
                    }
                </button>

                <button type="button" 
                        class="btn btn-outline-secondary w-100 mt-2" 
                        @onclick="Cancelar"
                        disabled="@guardando">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
            </div>
        </div>
    </div>

    <EditForm Model="@modelo" OnValidSubmit="GuardarBorrador" FormName="crearFacturaForm" style="display:none;">
        <DataAnnotationsValidator />
        <!-- Este formulario se mantiene oculto solo para validación -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-person-circle me-2"></i>
                1. Información del Cliente
            </h5>
        </div>
        <div class="card-body">
            @if (clienteSeleccionado == null)
            {
                <!-- Búsqueda de cliente -->
                <div class="row g-3">
                    <div class="col-md-10">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-search me-1"></i>Buscar Cliente
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   placeholder="Ingrese nombre o identificación del cliente..."
                                   @bind="terminoBusquedaCliente"
                                   @oninput="BuscarClientesIncremental" />
                            @if (!string.IsNullOrWhiteSpace(terminoBusquedaCliente))
                            {
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        @onclick="LimpiarBusquedaCliente">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>

                        <!-- Resultados de búsqueda -->
                        @if (clientesBuscados.Any())
                        {
                            <div class="list-group mt-2 shadow">
                                @foreach (var cliente in clientesBuscados)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-start"
                                            @onclick="() => SeleccionarCliente(cliente)">
                                        <div class="ms-2 me-auto">
                                            <div class="fw-bold">
                                                <i class="bi bi-person-badge me-1 text-primary"></i>
                                                @cliente.NombreCompleto
                                            </div>
                                            <small class="text-muted">
                                                <i class="bi bi-credit-card me-1"></i>
                                                @cliente.TipoIdentificacion: @cliente.Identificacion
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(cliente.Email))
                                            {
                                                <small class="text-muted ms-3">
                                                    <i class="bi bi-envelope me-1"></i>@cliente.Email
                                                </small>
                                            }
                                        </div>
                                        <span class="badge bg-success rounded-pill">
                                            <i class="bi bi-check-circle"></i>
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else if (buscandoClientes)
                        {
                            <div class="alert alert-info mt-2">
                                <i class="bi bi-hourglass-split me-2"></i>Buscando clientes...
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(terminoBusquedaCliente) && !buscandoClientes)
                        {
                            <div class="alert alert-warning mt-2">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                No se encontraron clientes con ese criterio
                            </div>
                        }
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button"
                                class="btn btn-success btn-lg w-100"
                                @onclick="AbrirModalNuevoCliente">
                            <i class="bi bi-plus-circle me-2"></i>
                            Nuevo
                        </button>
                    </div>
                </div>

                <ValidationMessage For="@(() => modelo.ClienteId)" class="text-danger mt-2" />
            }
            else
            {
                <!-- Cliente seleccionado -->
                <div class="alert alert-success border-start border-success border-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-3">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                Cliente Seleccionado
                            </h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-2">
                                        <strong><i class="bi bi-person me-2"></i>Nombre:</strong>
                                        <span class="ms-2">@clienteSeleccionado.NombreCompleto</span>
                                    </p>
                                    <p class="mb-2">
                                        <strong><i class="bi bi-credit-card me-2"></i>Identificación:</strong>
                                        <span class="ms-2">@clienteSeleccionado.Identificacion</span>
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    @if (!string.IsNullOrWhiteSpace(clienteSeleccionado.Email))
                                    {
                                        <p class="mb-2">
                                            <strong><i class="bi bi-envelope me-2"></i>Email:</strong>
                                            <span class="ms-2">@clienteSeleccionado.Email</span>
                                        </p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(clienteSeleccionado.Telefono))
                                    {
                                        <p class="mb-2">
                                            <strong><i class="bi bi-telephone me-2"></i>Teléfono:</strong>
                                            <span class="ms-2">@clienteSeleccionado.Telefono</span>
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                @onclick="DeseleccionarCliente">
                            <i class="bi bi-x-circle"></i> Cambiar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ==================== CARD PRODUCTOS ==================== -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-cart3 me-2"></i>
                    2. Productos y Servicios
                </h5>
                <button type="button"
                        class="btn btn-light btn-sm"
                        @onclick="AgregarNuevoDetalle"
                        disabled="@(clienteSeleccionado == null)">
                    <i class="bi bi-plus-circle me-1"></i>Agregar Producto
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (clienteSeleccionado == null)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Primero debe seleccionar un cliente
                </div>
            }
            else if (!modelo.Detalles.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                    <p class="text-muted mt-3">No hay productos agregados</p>
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="AgregarNuevoDetalle">
                        <i class="bi bi-plus-circle me-2"></i>Agregar Primer Producto
                    </button>
                </div>
            }
            else
            {
                <!-- Tabla de productos -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 30%;">Producto</th>
                                <th style="width: 10%;" class="text-center">Cantidad</th>
                                <th style="width: 12%;" class="text-end">P. Unitario</th>
                                <th style="width: 12%;" class="text-end">Descuento</th>
                                <th style="width: 10%;" class="text-center">IVA</th>
                                <th style="width: 13%;" class="text-end">Subtotal</th>
                                <th style="width: 8%;" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < modelo.Detalles.Count; i++)
                            {
                                var detalle = modelo.Detalles[i];
                                var index = i;

                                <tr class="@(detalle.ProductoId == 0 ? "table-warning" : "")">
                                    <td class="fw-bold text-muted">@(i + 1)</td>

                                    <!-- Producto Dropdown -->
                                    <td>
    @if (detalle.ProductoId == 0)
    {
        <div>
            <input type="text"
                   class="form-control form-control-sm"
                   placeholder="Buscar por código o nombre..."
                   @bind="detalle.BusquedaProducto"
                   @oninput="@(e => BuscarProductoIncremental(index, e.Value?.ToString() ?? ""))" />

            @if (detalle.ResultadosBusqueda != null && detalle.ResultadosBusqueda.Any())
{
    <div class="list-group shadow position-absolute" 
         style="z-index:1000; max-height:250px; overflow-y:auto; width: 100%;">
        @foreach (var p in detalle.ResultadosBusqueda)
        {
            <button type="button"
                    class="list-group-item list-group-item-action"
                    @onclick="() => SeleccionarProducto(index, p.Id)">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <!-- ✅ Código destacado -->
                        <div class="mb-1">
                            <span class="badge bg-primary me-2" 
                                  style="font-size: 0.85rem;">
                                @p.Codigo
                            </span>
                            <span class="fw-semibold">@p.Nombre</span>
                        </div>
                        <!-- Detalles -->
                        <small class="text-muted">
                            <i class="bi bi-cash-coin me-1"></i>
