@page "/facturas"
@rendermode InteractiveServer
@using SistemaFacturacionSRI.Domain.DTOs.Factura
@using SistemaFacturacionSRI.Domain.DTOs.Common
@using SistemaFacturacionSRI.WebUI.Services
@inject IFacturaHttpService FacturaService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Historial de Facturas</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            <i class="bi bi-receipt-cutoff me-2"></i>
            Historial de Facturas
        </h3>
        <a class="btn btn-sm btn-primary" href="/crearfactura">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva Factura
        </a>
    </div>

    @* Mensajes de éxito/error *@
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Éxito:</strong> @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
        </div>
    }

    <!-- Filtros de búsqueda -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label class="form-label fw-bold">Número de Factura:</label>
                    <input type="text" class="form-control" @bind="filtroNumero" 
                           placeholder="001-001-000000001">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fw-bold">Fecha Desde:</label>
                    <input type="date" class="form-control" @bind="filtroFechaDesde">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fw-bold">Fecha Hasta:</label>
                    <input type="date" class="form-control" @bind="filtroFechaHasta">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fw-bold">Estado:</label>
                    <select class="form-select" @bind="filtroEstado">
                        <option value="">Todos</option>
                        <option value="BORRADOR">Borrador</option>
                        <option value="GENERADA">Generada</option>
                        <option value="FIRMADA">Firmada</option>
                        <option value="ENVIADA">Enviada</option>
                        <option value="RECIBIDA">Recibida</option>
                        <option value="AUTORIZADA">Autorizada</option>
                        <option value="NO_AUTORIZADA">No Autorizada</option>
                        <option value="DEVUELTA">Devuelta</option>
                        <option value="ANULADA">Anulada</option>
                    </select>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12 text-end">
                    <button class="btn btn-secondary btn-sm me-2" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle me-1"></i>
                        Limpiar
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="() => CargarFacturas()">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando facturas...</p>
        </div>
    }
    else if (facturas == null || !facturas.Items.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle fs-1"></i>
            <p class="mb-0 mt-2">No se encontraron facturas con los filtros aplicados.</p>
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Mostrando <strong>@facturas.Items.Count</strong> de <strong>@facturas.TotalItems</strong> facturas
        </div>

        <!-- Vista Desktop (tabla completa) -->
        <div class="d-none d-lg-block">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Número</th>
                            <th>Fecha Emisión</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in facturas.Items)
                        {
                            <tr>
                                <td>
                                    <code class="text-primary">@factura.NumeroFactura</code>
                                </td>
                                <td>@factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <strong>@factura.Cliente?.RazonSocial</strong>
                                    <br>
                                    <small class="text-muted">@factura.Cliente?.Identificacion</small>
                                </td>
                                <td>
                                    <span class="badge @ObtenerColorEstado(factura.Estado)">
                                        @factura.Estado
                                    </span>
                                </td>
                                <td class="text-end">
                                    <strong>$@factura.Total.ToString("N2")</strong>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button class="btn btn-sm btn-info" 
                                                @onclick="() => VerDetalle(factura.Id)"
                                                title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" 
                                                @onclick="() => VerXml(factura.Id)"
                                                disabled="@string.IsNullOrEmpty(factura.XmlPath)"
                                                title="Ver XML">
                                            <i class="bi bi-filetype-xml"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" 
                                                @onclick="() => VerPdf(factura.Id)"
                                                disabled="@string.IsNullOrEmpty(factura.PdfPath)"
                                                title="Ver PDF">
                                            <i class="bi bi-filetype-pdf"></i>
                                        </button>
                                        @if (factura.Estado == "DEVUELTA" || factura.Estado == "NO_AUTORIZADA")
                                        {
                                            <button class="btn btn-sm btn-warning" 
                                                    @onclick="() => ReenviarSri(factura.Id)"
                                                    title="Reenviar al SRI">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        }
                                        @if (factura.Estado == "AUTORIZADA")
                                        {
                                            <button class="btn btn-sm btn-danger" 
                                                    @onclick="() => MostrarConfirmacionAnular(factura)"
                                                    title="Anular factura">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vista Mobile (cards) -->
        <div class="d-lg-none">
            @foreach (var factura in facturas.Items)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <code class="text-primary">@factura.NumeroFactura</code>
                                <p class="mb-0 mt-1">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </p>
                            </div>
                            <span class="badge @ObtenerColorEstado(factura.Estado) fs-6">
                                @factura.Estado
                            </span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <small class="text-muted d-block">Cliente</small>
                                <strong>@factura.Cliente?.RazonSocial</strong>
                                <br>
                                <small class="text-muted">@factura.Cliente?.Identificacion</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Total</small>
                                <strong class="fs-5">$@factura.Total.ToString("N2")</strong>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-info btn-sm" @onclick="() => VerDetalle(factura.Id)">
                                <i class="bi bi-eye me-1"></i>Ver Detalle
                            </button>
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-primary btn-sm" 
                                        @onclick="() => VerXml(factura.Id)"
                                        disabled="@string.IsNullOrEmpty(factura.XmlPath)">
                                    <i class="bi bi-filetype-xml me-1"></i>Ver XML
                                </button>
                                <button class="btn btn-outline-danger btn-sm" 
                                        @onclick="() => VerPdf(factura.Id)"
                                        disabled="@string.IsNullOrEmpty(factura.PdfPath)">
                                    <i class="bi bi-filetype-pdf me-1"></i>Ver PDF
                                </button>
                                @if (factura.Estado == "DEVUELTA" || factura.Estado == "NO_AUTORIZADA")
                                {
                                    <button class="btn btn-warning btn-sm" 
                                            @onclick="() => ReenviarSri(factura.Id)">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Reenviar
                                    </button>
                                }
                                @if (factura.Estado == "AUTORIZADA")
                                {
                                    <button class="btn btn-danger btn-sm" 
                                            @onclick="() => MostrarConfirmacionAnular(factura)">
                                        <i class="bi bi-trash me-1"></i>Anular
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        @if (facturas.TotalPages > 1)
        {
            <nav aria-label="Navegación de páginas">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!facturas.HasPreviousPage ? "disabled" : "")">
                        <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)" 
                                disabled="@(!facturas.HasPreviousPage)">
                            Anterior
                        </button>
                    </li>
                    
                    @for (int i = 1; i <= facturas.TotalPages; i++)
                    {
                        var pagina = i;
                        <li class="page-item @(paginaActual == pagina ? "active" : "")">
                            <button class="page-link" @onclick="() => CambiarPagina(pagina)">
                                @pagina
                            </button>
                        </li>
                    }

                    <li class="page-item @(!facturas.HasNextPage ? "disabled" : "")">
                        <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)" 
                                disabled="@(!facturas.HasNextPage)">
                            Siguiente
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@* Modal de confirmación para anular *@
@if (mostrarModalAnular)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Confirmar Anulación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarAnular"></button>
                </div>
                <div class="modal-body">
                    @if (facturaAAnular != null)
                    {
                        <p class="mb-3">¿Está seguro que desea anular la siguiente factura?</p>
                        <div class="card bg-light">
                            <div class="card-body">
                                <p class="mb-1"><strong>Número:</strong> @facturaAAnular.NumeroFactura</p>
                                <p class="mb-1"><strong>Cliente:</strong> @facturaAAnular.Cliente?.RazonSocial</p>
                                <p class="mb-0"><strong>Total:</strong> $@facturaAAnular.Total.ToString("N2")</p>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Motivo de anulación:</label>
                            <textarea class="form-control" rows="3" @bind="motivoAnulacion" 
                                      placeholder="Escriba el motivo..."></textarea>
                        </div>

                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Advertencia:</strong> Esta acción no se puede deshacer.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarAnular" disabled="@anulando">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarAnular" disabled="@anulando">
                        @if (anulando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Anulando...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash me-1"></i>
                            <span>Anular Factura</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResultDto<FacturaDto>? facturas;
    private bool cargando = true;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    // Filtros
    private string filtroNumero = string.Empty;
    private DateTime? filtroFechaDesde = null;
    private DateTime? filtroFechaHasta = null;
    private string filtroEstado = string.Empty;

    // Paginación
    private int paginaActual = 1;
    private int registrosPorPagina = 10;

    // Modal anular
    private bool mostrarModalAnular = false;
    private bool anulando = false;
    private FacturaDto? facturaAAnular = null;
    private string motivoAnulacion = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarFacturas();
            StateHasChanged();
        }
    }

    private async Task CargarFacturas()
    {
        try
        {
            cargando = true;
            mensajeError = string.Empty;

            facturas = await FacturaService.ObtenerFacturasAsync(
                paginaActual,
                registrosPorPagina,
                filtroNumero,
                filtroFechaDesde,
                filtroFechaHasta,
                filtroEstado);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar facturas: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void LimpiarFiltros()
    {
        filtroNumero = string.Empty;
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        filtroEstado = string.Empty;
        paginaActual = 1;
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        paginaActual = nuevaPagina;
        await CargarFacturas();
    }

    private void VerDetalle(int id)
    {
        Nav.NavigateTo($"/facturas/{id}");
    }

    private async Task DescargarXml(int id)
    {
        try
        {
            var content = await FacturaService.DescargarXmlAsync(id);

            if (content != null)
            {
                var base64 = Convert.ToBase64String(content);
                
                await JS.InvokeVoidAsync("downloadFile", 
                    "application/xml", 
                    base64, 
                    $"factura_{id}.xml");
                
                mensajeExito = "XML descargado exitosamente";
            }
            else
            {
                mensajeError = "Error al descargar XML";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al descargar XML: {ex.Message}";
        }
    }

    private async Task ReenviarSri(int id)
    {
        try
        {
            mensajeError = string.Empty;
            var exitoso = await FacturaService.ReenviarSriAsync(id);

            if (exitoso)
            {
                mensajeExito = "Factura reenviada al SRI exitosamente";
                await CargarFacturas();
            }
            else
            {
                mensajeError = "Error al reenviar al SRI";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al reenviar: {ex.Message}";
        }
    }

    private void MostrarConfirmacionAnular(FacturaDto factura)
    {
        facturaAAnular = factura;
        motivoAnulacion = string.Empty;
        mostrarModalAnular = true;
    }

    private void CancelarAnular()
    {
        mostrarModalAnular = false;
        facturaAAnular = null;
        motivoAnulacion = string.Empty;
    }

    private async Task ConfirmarAnular()
    {
        if (facturaAAnular == null) return;

        try
        {
            anulando = true;
            mensajeError = string.Empty;

            var exitoso = await FacturaService.AnularAsync(facturaAAnular.Id, motivoAnulacion);

            if (exitoso)
            {
                mensajeExito = $"Factura {facturaAAnular.NumeroFactura} anulada exitosamente";
                mostrarModalAnular = false;
                await CargarFacturas();
            }
            else
            {
                mensajeError = "Error al anular la factura";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al anular: {ex.Message}";
        }
        finally
        {
            anulando = false;
            facturaAAnular = null;
            motivoAnulacion = string.Empty;
        }
    }

    private async Task VerXml(int facturaId)
    {
        try
        {
            var url = $"/api/factura/{facturaId}/xml";
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al abrir XML: {ex.Message}";
        }
    }

    private async Task VerPdf(int facturaId)
    {
        try
        {
            var url = $"/api/factura/{facturaId}/pdf";
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al abrir PDF: {ex.Message}";
        }
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado switch
        {
            "BORRADOR" => "bg-secondary",
            "GENERADA" => "bg-info",
            "FIRMADA" => "bg-primary",
            "ENVIADA" => "bg-warning text-dark",
            "RECIBIDA" => "bg-warning text-dark",
            "AUTORIZADA" => "bg-success",
            "NO_AUTORIZADA" => "bg-danger",
            "DEVUELTA" => "bg-danger",
            "ANULADA" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}