    private async Task ReenviarSri()
    {
        try
        {
            reenviando = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
            
            var exitoso = await FacturaService.ReenviarSriAsync(Id);

            if (exitoso)
            {
                mensajeExito = "✅ Factura reenviada al SRI exitosamente. Actualizando datos...";
                await Task.Delay(2000);
                await CargarFactura();
            }
            else
            {
                mensajeError = "❌ Error al reenviar al SRI. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"❌ Error al reenviar: {ex.Message}";
        }
        finally
        {
            reenviando = false;
        }
    }

    private async Task CambiarAPendienteYReenviar()
    {
        if (factura == null) return;

        try
        {
            cambiandoEstado = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;

            // 1. Cambiar estado a PENDIENTE
            var resultadoCambio = await FacturaService.CambiarEstadoPendienteAsync(factura.Id);
            
            if (resultadoCambio?.Success != true)
            {
                mensajeError = $"❌ {resultadoCambio?.Message ?? "Error al cambiar estado a PENDIENTE"}";
                cambiandoEstado = false;
                return;
            }

            mensajeExito = "✅ Estado cambiado a PENDIENTE. Reenviando al SRI...";
            await Task.Delay(1000);

            // 2. Recargar factura para obtener el estado actualizado
            await CargarFactura();
            
            // 3. Reenviar al SRI
            var exitosoReenvio = await FacturaService.ReenviarSriAsync(factura.Id);

            if (exitosoReenvio)
            {
                mensajeExito = "✅ Factura reenviada al SRI exitosamente. Actualizando datos...";
                await Task.Delay(2000);
                await CargarFactura();
            }
            else
            {
                mensajeError = "❌ Error al reenviar al SRI. La factura quedó en estado PENDIENTE. Puede intentar reenviarla nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"❌ Error: {ex.Message}";
        }
        finally
        {
            cambiandoEstado = false;
        }
    }

    private async Task EnviarCorreoCliente()
    {
        if (factura == null || string.IsNullOrEmpty(factura.Cliente?.Email))
        {
            mensajeError = "El cliente no tiene un email registrado";
            return;
        }

        try
        {
            enviandoCorreo = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;

            // Confirmar con el usuario
            var confirmar = await JS.InvokeAsync<bool>("confirm", 
                $"¿Enviar factura {factura.NumeroFactura} al correo {factura.Cliente.Email}?\n\n" +
                "NOTA: Esta factura NO está autorizada por el SRI, pero puede ser útil para registro interno del cliente.");

            if (!confirmar)
            {
                enviandoCorreo = false;
                return;
            }

            // Llamar al endpoint de envío de correo
            var resultado = await FacturaService.EnviarCorreoClienteAsync(factura.Id);
            
            if (resultado?.Success == true)
            {
                mensajeExito = $"✅ {resultado.Message}";
                if (!string.IsNullOrEmpty(resultado.Aviso))
                {
                    mensajeExito += $"\n\n{resultado.Aviso}";
                }
                
                // Cerrar el modal si está abierto
                mostrarModalInfoSRI = false;
            }
            else
            {
                mensajeError = $"❌ {resultado?.Message ?? "Error desconocido al enviar correo"}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"❌ Error al enviar correo: {ex.Message}";
        }
        finally
        {
            enviandoCorreo = false;
        }
    }

