@page "/facturas/{id:int}"
@rendermode InteractiveServer
@using SistemaFacturacionSRI.Domain.DTOs.Factura
@using SistemaFacturacionSRI.WebUI.Services
@inject IFacturaHttpService FacturaService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Detalle de Factura</PageTitle>

<div class="container-fluid">
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando factura...</p>
        </div>
    }
    else if (factura == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> No se pudo cargar la factura.
            <button class="btn btn-sm btn-secondary ms-3" @onclick="Volver">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </button>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Detalle de Factura
            </h3>
            <button class="btn btn-sm btn-secondary" @onclick="Volver">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </button>
        </div>

        <!-- DEBUG: Ver datos de la factura -->
        <div class="alert alert-info">
            <details>
                <summary>Debug: Datos de la Factura (Click para ver)</summary>
                <pre>@System.Text.Json.JsonSerializer.Serialize(factura, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
            </details>
        </div>

        @* Alerta para código 58 del SRI *@
        @if (!string.IsNullOrEmpty(factura.MensajesSRI) && factura.MensajesSRI.Contains("[58]"))
        {
            <div class="alert alert-danger border-danger shadow-sm" role="alert">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-1">⚠️ Problema del SRI Detectado - Código 58</h5>
                        <p class="mb-0"><strong>ERROR EN LA ESTRUCTURA DE LA CLAVE DE ACCESO</strong></p>
                    </div>
                </div>
                <hr>
                <p class="mb-2">
                    🔴 <strong>Este es un problema del lado del SRI</strong>, no de tu factura. 
                    El SRI tiene registros corruptos en su base de datos de pruebas.
                </p>
                <p class="mb-2">
                    ✅ <strong>Tu factura está correctamente generada.</strong> La clave de acceso y todos los datos son válidos.
                </p>
                <div class="bg-light p-3 rounded mt-2">
                    <strong>📋 Mensaje del SRI:</strong>
                    <pre class="mb-0 mt-2 text-danger" style="font-size: 0.85rem; white-space: pre-wrap;">@factura.MensajesSRI</pre>
                </div>
                @if (factura.Estado == "PENDIENTE")
                {
                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Estado PENDIENTE:</strong> Puedes descargar XML/PDF o enviar el correo al cliente. 
                        Para reintentar con el SRI, usa el botón "Reenviar al SRI" más abajo.
                    </div>
                }
            </div>
        }

        @* Mensajes *@
        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        <!-- Información Principal -->
        <div class="row mb-3">
            <!-- Datos de la Factura -->
            <div class="col-12 col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-file-earmark-text me-2"></i>
                            Información de la Factura
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-5 fw-bold">Número:</div>
                            <div class="col-7">
                                <code class="text-primary fs-6">@factura.NumeroFactura</code>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 fw-bold">Fecha Emisión:</div>
                            <div class="col-7">@factura.FechaEmision.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 fw-bold">Estado:</div>
                            <div class="col-7">
                                <span class="badge @ObtenerColorEstado(factura.Estado)">
                                    @factura.Estado
                                </span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 fw-bold">Usuario Emisor:</div>
                            <div class="col-7">@factura.UsuarioNombre</div>
                        </div>
                        @if (!string.IsNullOrEmpty(factura.ClaveAcceso))
                        {
                            <div class="row mb-2">
                                <div class="col-5 fw-bold">Clave de Acceso:</div>
                                <div class="col-7">
                                    <small class="text-muted">@factura.ClaveAcceso</small>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(factura.Observaciones))
                        {
                            <div class="row">
                                <div class="col-12 fw-bold">Observaciones:</div>
                                <div class="col-12">
                                    <p class="text-muted mb-0">@factura.Observaciones</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Datos del Cliente -->
            <div class="col-12 col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-person-circle me-2"></i>
                            Datos del Cliente
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (factura.Cliente != null)
                        {
                            <table class="table table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <th class="fw-bold text-dark"><i class="bi bi-person-badge me-2"></i>Razón Social</th>
                                        <td>@factura.Cliente.RazonSocial</td>
                                    </tr>
                                    <tr>
                                        <th class="fw-bold text-dark"><i class="bi bi-credit-card-2-front me-2"></i>Identificación</th>
                                        <td>@factura.Cliente.Identificacion</td>
                                    </tr>
                                    <tr>
                                        <th class="fw-bold text-dark"><i class="bi bi-card-list me-2"></i>Tipo</th>
                                        <td>@factura.Cliente.TipoIdentificacion</td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(factura.Cliente.Direccion))
                                    {
                                        <tr>
                                            <th class="fw-bold text-dark"><i class="bi bi-geo-alt me-2"></i>Dirección</th>
                                            <td>@factura.Cliente.Direccion</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(factura.Cliente.Telefono))
                                    {
                                        <tr>
                                            <th class="fw-bold text-dark"><i class="bi bi-telephone me-2"></i>Teléfono</th>
                                            <td>@factura.Cliente.Telefono</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(factura.Cliente.Email))
                                    {
                                        <tr>
                                            <th class="fw-bold text-dark"><i class="bi bi-envelope me-2"></i>Email</th>
                                            <td>@factura.Cliente.Email</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Detalle de Productos -->
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    <i class="bi bi-cart3 me-2"></i>
                    Detalle de Productos
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">P. Unitario</th>
                                <th class="text-end">Descuento</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in factura.Detalles)
                            {
                                <tr>
                                    <td><code>@detalle.CodigoPrincipal</code></td>
                                    <td>@detalle.Descripcion</td>
                                    <td class="text-center">@detalle.Cantidad</td>
                                    <td class="text-end">$@detalle.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end">$@detalle.Descuento.ToString("N2")</td>
                                    <td class="text-end">$@detalle.PrecioTotalSinImpuesto.ToString("N2")</td>
                                    <td class="text-end">
                                        @if (detalle.Valor > 0)
                                        {
                                            <span class="badge bg-info">@detalle.Tarifa% - $@detalle.Valor.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">0%</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">$@detalle.ValorTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Totales -->
        <div class="row mb-3">
            <div class="col-12 col-lg-6 offset-lg-6">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-calculator me-2"></i>
                            Resumen de Totales
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-7 fw-bold">Subtotal 0%:</div>
                            <div class="col-5 text-end">$@factura.Subtotal0.ToString("N2")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-7 fw-bold">Subtotal 15%:</div>
                            <div class="col-5 text-end">$@factura.Subtotal15.ToString("N2")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-7 fw-bold">Subtotal Total:</div>
                            <div class="col-5 text-end">$@factura.SubtotalTotal.ToString("N2")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-7 fw-bold">Descuento:</div>
                            <div class="col-5 text-end text-danger">-$@factura.TotalDescuento.ToString("N2")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-7 fw-bold">IVA 15%:</div>
                            <div class="col-5 text-end">$@factura.TotalIVA.ToString("N2")</div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-7 fw-bold fs-5">TOTAL:</div>
                            <div class="col-5 text-end fw-bold fs-5 text-success">
                                $@factura.Total.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Autorización SRI -->
        @if (factura.Estado == "AUTORIZADA")
        {
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Información de Autorización SRI
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-md-6 mb-2">
                            <strong>Número de Autorización:</strong>
                            <p class="text-muted mb-0">@factura.NumeroAutorizacion</p>
                        </div>
                        <div class="col-12 col-md-6 mb-2">
                            <strong>Fecha de Autorización:</strong>
                            <p class="text-muted mb-0">
                                @(factura.FechaAutorizacion?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")
                            </p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(factura.MensajesSRI))
                    {
                        <div class="row mt-2">
                            <div class="col-12">
                                <strong>Mensajes del SRI:</strong>
                                <pre class="bg-light p-2 rounded">@factura.MensajesSRI</pre>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (factura.Estado == "NO_AUTORIZADA" || factura.Estado == "DEVUELTA")
        {
            <div class="card mb-3 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        Información de Rechazo SRI
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(factura.MensajesSRI))
                    {
                        <strong>Mensajes del SRI:</strong>
                        <pre class="bg-light p-2 rounded text-danger">@factura.MensajesSRI</pre>
                        
                        @* Detectar error específico de clave de acceso corrupta *@
                        @if (factura.MensajesSRI.Contains("ERROR EN LA ESTRUCTURA DE LA CLAVE DE ACCESO") && 
                            (factura.MensajesSRI.Contains("100 contenido en la clave") || 
                             factura.MensajesSRI.Contains("100000000 contenido en la clave")))
                        {
                            <div class="alert alert-warning mt-3">
                                <h6 class="alert-heading">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    ℹ️ Problema Detectado: Caché Corrupto del SRI
                                </h6>
                                <hr>
                                <p class="mb-2">
                                    <strong>El SRI tiene registros corruptos en su base de datos de pruebas.</strong> 
                                    Los valores <code>100</code>, <code>100</code>, <code>100000000</code> son de intentos anteriores fallidos.
                                </p>
                                <p class="mb-2">
                                    ✅ <strong>Tu factura está correctamente generada</strong> con valores <code>001-001-@factura.NumeroFactura.Split('-')[2]</code>
                                </p>
                                <p class="mb-0">
                                    <strong>Soluciones:</strong>
                                </p>
                                <ul class="mb-0">
                                    <li>⏰ Esperar 24-48 horas (el SRI limpia su caché periódicamente)</li>
                                    <li>📧 Enviar la factura al cliente de todos modos (ver botón abajo)</li>
                                    <li>📞 Contactar al soporte técnico del SRI para limpiar registros</li>
                                    <li>🔄 Intentar con un secuencial muy diferente (ej: +100)</li>
                                </ul>
                                <button class="btn btn-sm btn-outline-info mt-2" @onclick="() => mostrarModalInfoSRI = true">
                                    <i class="bi bi-question-circle me-1"></i>
                                    Ver más información
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">La factura fue rechazada por el SRI.</p>
                    }
                </div>
            </div>
        }

        <!-- Botones de Acción -->
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <!-- Botones para XML -->
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary" 
                                @onclick="VerXml"
                                disabled="@string.IsNullOrEmpty(factura.XmlPath)"
                                title="Ver XML en una nueva pestaña">
                            <i class="bi bi-eye me-1"></i>
                            Ver XML
                        </button>
                        <button class="btn btn-outline-primary" 
                                @onclick="DescargarXml"
                                disabled="@string.IsNullOrEmpty(factura.XmlPath)"
                                title="Descargar archivo XML">
                            <i class="bi bi-download me-1"></i>
                        </button>
                    </div>

                    <!-- Botones para PDF -->
                    <div class="btn-group" role="group">
                        <button class="btn btn-danger" 
                                @onclick="VerPdf"
                                disabled="@string.IsNullOrEmpty(factura.PdfPath)"
                                title="Ver PDF en una nueva pestaña">
                            <i class="bi bi-eye me-1"></i>
                            Ver PDF
                        </button>
                        <button class="btn btn-outline-danger" 
                                @onclick="DescargarPdf"
                                disabled="@string.IsNullOrEmpty(factura.PdfPath)"
                                title="Descargar archivo PDF">
                            <i class="bi bi-download me-1"></i>
                        </button>
                    </div>

                    @if (factura.Estado == "DEVUELTA" || factura.Estado == "NO_AUTORIZADA")
                    {
                        <button class="btn btn-warning" @onclick="CambiarAPendienteYReenviar" disabled="@cambiandoEstado">
                            @if (cambiandoEstado)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Procesando...</text>
                            }
                            else
                            {
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                <text>Reenviar al SRI</text>
                            }
                        </button>
                        
                        @* Botón para enviar por correo de todos modos *@
                        @if (!string.IsNullOrEmpty(factura.Cliente?.Email))
                        {
                            <button class="btn btn-info" @onclick="EnviarCorreoCliente" disabled="@enviandoCorreo">
                                @if (enviandoCorreo)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <text>Enviando...</text>
                                }
                                else
                                {
                                    <i class="bi bi-envelope-fill me-1"></i>
                                    <text>Enviar a Cliente de Todos Modos</text>
                                }
                            </button>
                        }
                    }
                    else if (factura.Estado == "PENDIENTE")
                    {
                        <button class="btn btn-warning" @onclick="ReenviarSri" disabled="@reenviando">
                            @if (reenviando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Reenviando...</text>
                            }
                            else
                            {
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                <text>Enviar Factura al SRI</text>
                            }
                        </button>
                        
                        @* Botón para enviar por correo cuando está pendiente *@
                        @if (!string.IsNullOrEmpty(factura.Cliente?.Email))
                        {
                            <button class="btn btn-info" @onclick="EnviarCorreoCliente" disabled="@enviandoCorreo">
                                @if (enviandoCorreo)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <text>Enviando...</text>
                                }
                                else
                                {
                                    <i class="bi bi-envelope-fill me-1"></i>
                                    <text>Enviar a Cliente</text>
                                }
                            </button>
                        }
                    }

                    <button class="btn btn-secondary" @onclick="Volver">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver al Historial
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Información Detallada del Error SRI -->
@if (mostrarModalInfoSRI)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Información sobre el Error del SRI
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalInfoSRI = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <h6 class="alert-heading">🔍 ¿Qué está pasando?</h6>
                        <p>
                            El Servicio de Rentas Internas (SRI) tiene registros corruptos en su base de datos de pruebas 
                            de intentos anteriores que no se completaron correctamente.
                        </p>
                    </div>

                    <h6 class="text-danger">❌ Lo que reporta el SRI:</h6>
                    <div class="bg-light p-3 rounded mb-3">
                        <ul class="mb-0">
                            <li>Establecimiento: <code class="text-danger">100</code> (valor corrupto)</li>
                            <li>Punto de Emisión: <code class="text-danger">100</code> (valor corrupto)</li>
                            <li>Secuencial: <code class="text-danger">100000000</code> (valor corrupto)</li>
                        </ul>
                    </div>

                    <h6 class="text-success">✅ Lo que realmente enviamos:</h6>
                    <div class="bg-light p-3 rounded mb-3">
                        <ul class="mb-0">
                            <li>Establecimiento: <code class="text-success">001</code> ✓</li>
                            <li>Punto de Emisión: <code class="text-success">001</code> ✓</li>
                            <li>Secuencial: <code class="text-success">@(factura?.NumeroFactura?.Split('-')[2] ?? "00000000X")</code> ✓</li>
                            <li>Clave de Acceso: <code class="text-muted small">@factura?.ClaveAcceso</code></li>
                        </ul>
                    </div>

                    <h6>💡 Soluciones Recomendadas:</h6>
                    <div class="accordion" id="accordionSoluciones">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1">
                                    1️⃣ Esperar limpieza automática del SRI (Recomendado)
                                </button>
                            </h2>
                            <div id="collapse1" class="accordion-collapse collapse show">
                                <div class="accordion-body">
                                    <p><strong>Tiempo estimado:</strong> 24-48 horas</p>
                                    <p>El SRI limpia periódicamente su caché de pruebas. Esta es la solución más segura.</p>
                                    <p class="mb-0">
                                        <strong>Mientras tanto:</strong> Puede enviar la factura al cliente con el botón 
                                        <span class="badge bg-info">Enviar a Cliente de Todos Modos</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2">
                                    2️⃣ Contactar Soporte Técnico del SRI
                                </button>
                            </h2>
                            <div id="collapse2" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    <p><strong>Contacto:</strong></p>
                                    <ul>
                                        <li>📞 Teléfono: 1700 774 774</li>
                                        <li>📧 Email: info@sri.gob.ec</li>
                                        <li>🌐 Portal: <a href="https://www.sri.gob.ec" target="_blank">www.sri.gob.ec</a></li>
                                    </ul>
                                    <p class="mb-0">
                                        <strong>Información a proporcionar:</strong>
                                    </p>
                                    <ul class="mb-0">
                                        <li>RUC: @factura?.Cliente?.Identificacion</li>
                                        <li>Clave de Acceso: @factura?.ClaveAcceso</li>
                                        <li>Mensaje: "Caché corrupto en ambiente de pruebas con valores 100-100-100000000"</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3">
                                    3️⃣ Usar un secuencial diferente
                                </button>
                            </h2>
                            <div id="collapse3" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    <p>Crear una nueva factura con un número de secuencial muy diferente al actual.</p>
                                    <p><strong>Ejemplo:</strong> Si el actual es <code>000000005</code>, probar con <code>000000100</code></p>
                                    <p class="text-warning mb-0">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        <strong>Nota:</strong> Esto puede no funcionar si el SRI tiene múltiples secuenciales corruptos.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success mt-3 mb-0">
                        <h6 class="alert-heading">
                            <i class="bi bi-shield-check me-2"></i>
                            Tu Sistema Está Funcionando Correctamente
                        </h6>
                        <p class="mb-0">
                            Este error NO es causado por tu sistema de facturación. Los XMLs generados cumplen 
                            perfectamente con el estándar del SRI. El problema es exclusivamente en los servidores 
                            de pruebas del SRI.
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (!string.IsNullOrEmpty(factura?.Cliente?.Email))
                    {
                        <button class="btn btn-info" @onclick="EnviarCorreoCliente" disabled="@enviandoCorreo">
                            @if (enviandoCorreo)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Enviando...</text>
                            }
                            else
                            {
                                <i class="bi bi-envelope-fill me-1"></i>
                                <text>Enviar a Cliente</text>
                            }
                        </button>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="() => mostrarModalInfoSRI = false">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private FacturaDto? factura;
    private bool cargando = true;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private bool mostrarModalInfoSRI = false;
    private bool enviandoCorreo = false;
    private bool cambiandoEstado = false;
    private bool reenviando = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarFactura();
            StateHasChanged();
        }
    }

    private async Task CargarFactura()
    {
        try
        {
            cargando = true;
            mensajeError = string.Empty;

            factura = await FacturaService.ObtenerPorIdAsync(Id);

            if (factura == null)
            {
                mensajeError = $"Factura con ID {Id} no encontrada";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar la factura: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task DescargarXml()
    {
        try
        {
            mensajeError = string.Empty;
            var content = await FacturaService.DescargarXmlAsync(Id);

            if (content != null)
            {
                var base64 = Convert.ToBase64String(content);
                
                await JS.InvokeVoidAsync("downloadFile", 
                    "application/xml", 
                    base64, 
                    $"factura_{factura?.NumeroFactura?.Replace("-", "")}.xml");
                
                mensajeExito = "XML descargado exitosamente";
            }
            else
            {
                mensajeError = "Error al descargar XML";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al descargar XML: {ex.Message}";
        }
    }

    private async Task DescargarPdf()
    {
        try
        {
            mensajeError = string.Empty;
            var content = await FacturaService.DescargarPdfAsync(Id);

            if (content != null)
            {
                var base64 = Convert.ToBase64String(content);
                
                await JS.InvokeVoidAsync("downloadFile", 
                    "application/pdf", 
                    base64, 
                    $"factura_{factura?.NumeroFactura?.Replace("-", "")}.pdf");
                
                mensajeExito = "PDF descargado exitosamente";
            }
            else
            {
                mensajeError = "Error al descargar PDF";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al descargar PDF: {ex.Message}";
        }
    }

    private async Task ReenviarSri()
    {
        try
        {
            reenviando = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
            
            var exitoso = await FacturaService.ReenviarSriAsync(Id);

            if (exitoso)
            {
                mensajeExito = "✅ Factura reenviada al SRI exitosamente. Actualizando datos...";
                await Task.Delay(2000);
                await CargarFactura();
            }
            else
            {
                mensajeError = "❌ Error al reenviar al SRI. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"❌ Error al reenviar: {ex.Message}";
        }
        finally
        {
            reenviando = false;
        }
    }

    private async Task CambiarAPendienteYReenviar()
    {
        if (factura == null) return;

        try
        {
            cambiandoEstado = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;

            // 1. Cambiar estado a PENDIENTE
            var resultadoCambio = await FacturaService.CambiarEstadoPendienteAsync(factura.Id);
            
            if (resultadoCambio?.Success != true)
            {
                mensajeError = $"❌ {resultadoCambio?.Message ?? "Error al cambiar estado a PENDIENTE"}";
                cambiandoEstado = false;
                return;
            }

            mensajeExito = "✅ Estado cambiado a PENDIENTE. Reenviando al SRI...";
            await Task.Delay(1000);

            // 2. Recargar factura para obtener el estado actualizado
            await CargarFactura();
            
            // 3. Reenviar al SRI
            var exitosoReenvio = await FacturaService.ReenviarSriAsync(factura.Id);

            if (exitosoReenvio)
            {
                mensajeExito = "✅ Factura reenviada al SRI exitosamente. Actualizando datos...";
                await Task.Delay(2000);
                await CargarFactura();
            }
            else
            {
                mensajeError = "❌ Error al reenviar al SRI. La factura quedó en estado PENDIENTE. Puede intentar reenviarla nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"❌ Error: {ex.Message}";
        }
        finally
        {
            cambiandoEstado = false;
        }
    }

    private async Task EnviarCorreoCliente()
    {
        if (factura == null || string.IsNullOrEmpty(factura.Cliente?.Email))
        {
            mensajeError = "El cliente no tiene un email registrado";
            return;
        }

        try
        {
            enviandoCorreo = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;

            // Confirmar con el usuario
            var confirmar = await JS.InvokeAsync<bool>("confirm", 
                $"¿Enviar factura {factura.NumeroFactura} al correo {factura.Cliente.Email}?\n\n" +
                "NOTA: Esta factura NO está autorizada por el SRI, pero puede ser útil para registro interno del cliente.");

            if (!confirmar)
            {
                enviandoCorreo = false;
                return;
            }

            // Llamar al endpoint de envío de correo
            var resultado = await FacturaService.EnviarCorreoClienteAsync(factura.Id);
            
            if (resultado?.Success == true)
            {
                mensajeExito = $"✅ {resultado.Message}";
                if (!string.IsNullOrEmpty(resultado.Aviso))
                {
                    mensajeExito += $"\n\n{resultado.Aviso}";
                }
                
                // Cerrar el modal si está abierto
                mostrarModalInfoSRI = false;
            }
            else
            {
                mensajeError = $"❌ {resultado?.Message ?? "Error desconocido al enviar correo"}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"❌ Error al enviar correo: {ex.Message}";
        }
        finally
        {
            enviandoCorreo = false;
        }
    }

    private async Task VerXml()
    {
        if (factura == null || string.IsNullOrEmpty(factura.XmlPath))
        {
            mensajeError = "No hay archivo XML disponible";
            return;
        }

        try
        {
            // Abrir el XML en una nueva pestaña del navegador
            var url = $"/api/factura/{factura.Id}/xml";
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al abrir XML: {ex.Message}";
        }
    }

    private async Task VerPdf()
    {
        if (factura == null || string.IsNullOrEmpty(factura.PdfPath))
        {
            mensajeError = "No hay archivo PDF disponible";
            return;
        }

        try
        {
            // Abrir el PDF en una nueva pestaña del navegador
            var url = $"/api/factura/{factura.Id}/pdf";
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al abrir PDF: {ex.Message}";
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/facturas");
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado switch
        {
            "BORRADOR" => "bg-secondary",
            "GENERADA" => "bg-info",
            "FIRMADA" => "bg-primary",
            "ENVIADA" => "bg-warning text-dark",
            "RECIBIDA" => "bg-warning text-dark",
            "PENDIENTE" => "bg-warning text-dark",
            "AUTORIZADA" => "bg-success",
            "NO_AUTORIZADA" => "bg-danger",
            "DEVUELTA" => "bg-danger",
            "ANULADA" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}