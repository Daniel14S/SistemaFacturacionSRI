@code {
    private PagedResultDto<ClienteListDto> _clientes = new();
    private string _searchTerm = string.Empty;
    private string _filtroTipoId = string.Empty;
    private string _filtroEstado = string.Empty;
    private bool _loading = true;
    private Timer? _searchTimer;
    private bool _mostrarModalEstado = false;
    private int _clienteIdModal = 0;
    private bool _nuevoEstadoModal = false;
    private string _nombreClienteModal = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        try
        {
            _loading = true;

            var filtro = new FiltroClienteDto
            {
                Busqueda = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
                TipoIdentificacionId = string.IsNullOrWhiteSpace(_filtroTipoId) ? null : int.Parse(_filtroTipoId),
                Estado = string.IsNullOrWhiteSpace(_filtroEstado) ? null : bool.Parse(_filtroEstado),
                PageNumber = _clientes.PageNumber > 0 ? _clientes.PageNumber : 1,
                PageSize = 10
            };

            _clientes = await ClienteService.ObtenerClientesAsync(filtro);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar clientes: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchChanged()
    {
        _searchTimer?.Dispose();
        _searchTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                _clientes.PageNumber = 1;
                await CargarClientes();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _clientes.PageNumber = 1;
        InvokeAsync(CargarClientes);
    }

    private async Task OnFiltroChanged()
    {
        _clientes.PageNumber = 1;
        await CargarClientes();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= _clientes.TotalPages)
        {
            _clientes.PageNumber = nuevaPagina;
            await CargarClientes();
        }
    }

    private void MostrarConfirmacionEstado(int clienteId, bool activar, string nombreCliente)
    {
        _clienteIdModal = clienteId;
        _nuevoEstadoModal = activar;
        _nombreClienteModal = nombreCliente;
        _mostrarModalEstado = true;
    }

    private async Task ConfirmarCambioEstado()
    {
        try
        {
            await ClienteService.CambiarEstadoAsync(_clienteIdModal, _nuevoEstadoModal);
            ToastService.ShowSuccess(_nuevoEstadoModal ? "Cliente activado exitosamente" : "Cliente desactivado exitosamente");
            _mostrarModalEstado = false;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cambiar estado: {ex.Message}");
            _mostrarModalEstado = false;
        }
    }

    private void CancelarCambioEstado()
    {
        _mostrarModalEstado = false;
    }

    private void CrearNuevoCliente() => Navigation.NavigateTo("/clientes/crear");
    private void EditarCliente(int id) => Navigation.NavigateTo($"/clientes/editar/{id}");

    private string GetTipoIdClass(string tipoId) => tipoId.ToLower() switch
    {
        "cédula" or "cedula" => "cedula",
        "ruc" => "ruc",
        "pasaporte" => "pasaporte",
        _ => "cedula"
    };

    private string GetTipoIdIcon(string tipoId) => tipoId switch
    {
        "Cédula" => "bi-person-vcard-fill",
        "RUC" => "bi-building-fill",
        "Pasaporte" => "bi-airplane-fill",
        _ => "bi-card-text"
    };

    private string GetInitials(string nombreCompleto)
    {
        var parts = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts.Length > 0 ? parts[0][0].ToString().ToUpper() : "?";
    }

    public void Dispose() => _searchTimer?.Dispose();
}