@page "/usuarios"
@rendermode InteractiveServer
@using SistemaFacturacionSRI.Domain.DTOs.Auth
@using SistemaFacturacionSRI.WebUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@inject IUsuarioHttpService UsuarioService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Gestión de Usuarios</PageTitle>

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Header Corporativo -->
    <div class="header-corporativo mb-4">
        <div class="row align-items-center">
            <div class="col-12 col-lg-8 mb-3 mb-lg-0">
                <div class="d-flex align-items-center">
                    <div class="icon-header me-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h2 class="titulo-corporativo mb-1">Gestión de Usuarios</h2>
                        <p class="subtitulo-corporativo mb-0">
                            <i class="bi bi-shield-lock me-2"></i>
                            Control de acceso y permisos del sistema
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <button class="btn btn-corporativo w-100" @onclick="CrearNuevoUsuario">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    Nuevo Usuario
                </button>
            </div>
        </div>
    </div>

    <!-- Card de Filtros -->
    <div class="card card-filtros mb-4">
        <div class="card-body">
            <div class="row g-3">
                <!-- Búsqueda -->
                <div class="col-12 col-lg-6">
                    <label class="form-label label-corporativo">
                        <i class="bi bi-search me-2"></i>Búsqueda
                    </label>
                    <div class="input-group input-corporativo">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Buscar por usuario, email o nombre..." 
                               @bind="_searchTerm"
                               @bind:event="oninput"
                               @onkeyup="OnSearchChanged" />
                        @if (!string.IsNullOrEmpty(_searchTerm))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Filtro Rol -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label label-corporativo">
                        <i class="bi bi-person-badge me-2"></i>Rol
                    </label>
                    <select class="form-select select-corporativo" @bind="_filtroRol" @bind:after="OnFiltroChanged">
                        <option value="">Todos los roles</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Vendedor">Vendedor</option>
                    </select>
                </div>

                <!-- Filtro Estado -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label class="form-label label-corporativo">
                        <i class="bi bi-toggle2-on me-2"></i>Estado
                    </label>
                    <select class="form-select select-corporativo" @bind="_filtroEstado" @bind:after="OnFiltroChanged">
                        <option value="">Todos los estados</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido -->
    @if (_loading)
    {
        <div class="loading-container">
            <div class="spinner-corporativo">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
            <p class="loading-text">Cargando usuarios...</p>
        </div>
    }
    else if (!_usuariosFiltrados.Any())
    {
        <div class="alert alert-empty">
            <div class="text-center">
                <i class="bi bi-person-x display-1 mb-3 d-block"></i>
                <h5>No se encontraron usuarios</h5>
                <p class="mb-0">No hay usuarios que coincidan con los criterios de búsqueda.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Contador de resultados -->
        <div class="alert alert-resultados mb-3">
            <i class="bi bi-check2-circle me-2"></i>
            Mostrando <strong>@_usuariosPaginados.Count</strong> de <strong>@_usuariosFiltrados.Count</strong> usuarios encontrados
        </div>

        <!-- Vista Desktop - Tabla -->
        <div class="d-none d-lg-block">
            <div class="tabla-corporativa">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th width="80" class="text-center">ID</th>
                            <th width="180">Usuario</th>
                            <th>Email</th>
                            <th>Nombre Completo</th>
                            <th width="140" class="text-center">Rol</th>
                            <th width="110" class="text-center">Estado</th>
                            <th width="150" class="text-center">Último Acceso</th>
                            <th width="140" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in _usuariosPaginados)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge-id">#@usuario.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-usuario me-2">
                                            @GetInitials(usuario.Username)
                                        </div>
                                        <div>
                                            <div class="nombre-usuario">@usuario.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="email-container">
                                        <i class="bi bi-envelope-fill text-primary me-2"></i>
                                        <span class="text-truncate">@usuario.Email</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(usuario.NombreCompleto))
                                    {
                                        <span>@usuario.NombreCompleto</span>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Sin nombre completo</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-rol-@GetRolClass(usuario.Rol)">
                                        <i class="@GetRolIcon(usuario.Rol) me-1"></i>
                                        @usuario.Rol
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-estado-@(usuario.Estado ? "activo" : "inactivo")">
                                        <i class="bi @(usuario.Estado ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                        @(usuario.Estado ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (usuario.UltimoAcceso.HasValue)
                                    {
                                        <div class="ultimo-acceso">
                                            <small class="d-block">@usuario.UltimoAcceso.Value.ToString("dd/MM/yyyy")</small>
                                            <small class="text-muted">@usuario.UltimoAcceso.Value.ToString("HH:mm")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Sin accesos</small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group-acciones">
                                        <button class="btn btn-accion btn-editar" 
                                                @onclick="() => EditarUsuario(usuario.Id)"
                                                title="Editar usuario">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        @if (usuario.Estado)
                                        {
                                            <button class="btn btn-accion btn-desactivar" 
                                                    @onclick="() => MostrarConfirmacionEstado(usuario.Id, false, usuario.Username)"
                                                    title="Desactivar usuario">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-accion btn-activar" 
                                                    @onclick="() => MostrarConfirmacionEstado(usuario.Id, true, usuario.Username)"
                                                    title="Activar usuario">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vista Tablet - Cards Horizontales -->
        <div class="d-none d-md-block d-lg-none">
            @foreach (var usuario in _usuariosPaginados)
            {
                <div class="card card-usuario-tablet mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="avatar-usuario me-3">
                                        @GetInitials(usuario.Username)
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="nombre-usuario mb-1">@usuario.Username</h6>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge badge-rol-@GetRolClass(usuario.Rol)">
                                                <i class="@GetRolIcon(usuario.Rol) me-1"></i>
                                                @usuario.Rol
                                            </span>
                                            <small class="text-muted">ID: @usuario.Id</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="info-contacto-tablet">
                                    <div class="mb-1">
                                        <i class="bi bi-envelope-fill text-primary me-2"></i>
                                        <span>@usuario.Email</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(usuario.NombreCompleto))
                                    {
                                        <div>
                                            <i class="bi bi-person-fill text-secondary me-2"></i>
                                            <span>@usuario.NombreCompleto</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-md-end align-items-center gap-2 mt-3 mt-md-0">
                                    <div class="info-acceso">
                                        @if (usuario.UltimoAcceso.HasValue)
                                        {
                                            <small class="text-muted d-block">Último acceso:</small>
                                            <small class="fw-semibold">@usuario.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Sin accesos</small>
                                        }
                                    </div>
                                    <span class="badge badge-estado-@(usuario.Estado ? "activo" : "inactivo")">
                                        <i class="bi @(usuario.Estado ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                        @(usuario.Estado ? "Activo" : "Inactivo")
                                    </span>
                                    <div class="btn-group-acciones">
                                        <button class="btn btn-accion btn-editar" @onclick="() => EditarUsuario(usuario.Id)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        @if (usuario.Estado)
                                        {
                                            <button class="btn btn-accion btn-desactivar" 
                                                    @onclick="() => MostrarConfirmacionEstado(usuario.Id, false, usuario.Username)">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-accion btn-activar" 
                                                    @onclick="() => MostrarConfirmacionEstado(usuario.Id, true, usuario.Username)">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Vista Mobile - Cards Verticales -->
        <div class="d-md-none">
            @foreach (var usuario in _usuariosPaginados)
            {
                <div class="card card-usuario-mobile mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center flex-grow-1">
                                <div class="avatar-usuario me-2">
                                    @GetInitials(usuario.Username)
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="nombre-usuario mb-0">@usuario.Username</h6>
                                    <small class="text-muted">ID: @usuario.Id</small>
                                </div>
                            </div>
                            <span class="badge badge-estado-@(usuario.Estado ? "activo" : "inactivo")">
                                @(usuario.Estado ? "Activo" : "Inactivo")
                            </span>
                        </div>

                        <div class="info-mobile mb-3">
                            <div class="mb-2">
                                <span class="badge badge-rol-@GetRolClass(usuario.Rol)">
                                    <i class="@GetRolIcon(usuario.Rol) me-1"></i>
                                    @usuario.Rol
                                </span>
                            </div>

                            <div class="contacto-item-mobile mb-2">
                                <i class="bi bi-envelope-fill text-primary me-2"></i>
                                <span class="text-break">@usuario.Email</span>
                            </div>

                            @if (!string.IsNullOrEmpty(usuario.NombreCompleto))
                            {
                                <div class="contacto-item-mobile mb-2">
                                    <i class="bi bi-person-fill text-secondary me-2"></i>
                                    <span>@usuario.NombreCompleto</span>
                                </div>
                            }

                            @if (usuario.UltimoAcceso.HasValue)
                            {
                                <div class="contacto-item-mobile">
                                    <i class="bi bi-clock-fill text-info me-2"></i>
                                    <span>@usuario.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                            else
                            {
                                <div class="contacto-item-mobile">
                                    <i class="bi bi-clock-fill text-muted me-2"></i>
                                    <span class="text-muted">Sin accesos registrados</span>
                                </div>
                            }
                        </div>

                        <div class="acciones-mobile">
                            <button class="btn btn-mobile btn-editar" @onclick="() => EditarUsuario(usuario.Id)">
                                <i class="bi bi-pencil-square me-2"></i>Editar
                            </button>
                            @if (usuario.Estado)
                            {
                                <button class="btn btn-mobile btn-desactivar" 
                                        @onclick="() => MostrarConfirmacionEstado(usuario.Id, false, usuario.Username)">
                                    <i class="bi bi-x-circle me-2"></i>Desactivar
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-mobile btn-activar" 
                                        @onclick="() => MostrarConfirmacionEstado(usuario.Id, true, usuario.Username)">
                                    <i class="bi bi-check-circle me-2"></i>Activar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        @if (_totalPaginas > 1)
        {
            <nav aria-label="Paginación de usuarios" class="mt-4">
                <ul class="pagination pagination-corporativa justify-content-center">
                    <li class="page-item @(_paginaActual == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => CambiarPagina(_paginaActual - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>

                    @if (_totalPaginas <= 7)
                    {
                        @for (int i = 1; i <= _totalPaginas; i++)
                        {
                            var pagina = i;
                            <li class="page-item @(_paginaActual == pagina ? "active" : "")">
                                <button class="page-link" @onclick="() => CambiarPagina(pagina)">
                                    @pagina
                                </button>
                            </li>
                        }
                    }
                    else
                    {
                        @if (_paginaActual <= 4)
                        {
                            @for (int i = 1; i <= 5; i++)
                            {
                                var pagina = i;
                                <li class="page-item @(_paginaActual == pagina ? "active" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(pagina)">@pagina</button>
                                </li>
                            }
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            <li class="page-item">
                                <button class="page-link" @onclick="() => CambiarPagina(_totalPaginas)">@_totalPaginas</button>
                            </li>
                        }
                        else if (_paginaActual >= _totalPaginas - 3)
                        {
                            <li class="page-item">
                                <button class="page-link" @onclick="() => CambiarPagina(1)">1</button>
                            </li>
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            @for (int i = _totalPaginas - 4; i <= _totalPaginas; i++)
                            {
                                var pagina = i;
                                <li class="page-item @(_paginaActual == pagina ? "active" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(pagina)">@pagina</button>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="page-item">
                                <button class="page-link" @onclick="() => CambiarPagina(1)">1</button>
                            </li>
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            @for (int i = _paginaActual - 1; i <= _paginaActual + 1; i++)
                            {
                                var pagina = i;
                                <li class="page-item @(_paginaActual == pagina ? "active" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(pagina)">@pagina</button>
                                </li>
                            }
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            <li class="page-item">
                                <button class="page-link" @onclick="() => CambiarPagina(_totalPaginas)">@_totalPaginas</button>
                            </li>
                        }
                    }

                    <li class="page-item @(_paginaActual == _totalPaginas ? "disabled" : "")">
                        <button class="page-link" @onclick="() => CambiarPagina(_paginaActual + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<!-- Modal de Confirmación -->
@if (_mostrarModalEstado)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(30, 58, 95, 0.7);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-corporativo">
                <div class="modal-header @(_nuevoEstadoModal ? "modal-header-success" : "modal-header-danger")">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Confirmar Cambio de Estado
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarCambioEstado"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        ¿Está seguro que desea <strong class="@(_nuevoEstadoModal ? "text-success" : "text-danger")">
                        @(_nuevoEstadoModal ? "ACTIVAR" : "DESACTIVAR")</strong> al siguiente usuario?
                    </p>
                    <div class="alert alert-info-modal">
                        <i class="bi bi-person-fill me-2"></i>
                        <strong>@_nombreUsuarioModal</strong>
                    </div>
                    @if (!_nuevoEstadoModal)
                    {
                        <div class="alert alert-warning-modal">
                            <i class="bi bi-info-circle me-2"></i>
                            El usuario no podrá acceder al sistema una vez desactivado.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarCambioEstado">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </button>
                    <button type="button" class="btn @(_nuevoEstadoModal ? "btn-success" : "btn-danger")" @onclick="ConfirmarCambioEstado">
                        <i class="bi @(_nuevoEstadoModal ? "bi-check-circle" : "bi-x-circle") me-2"></i>
                        @(_nuevoEstadoModal ? "Activar" : "Desactivar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* ============================================
   VARIABLES Y BASE
   ============================================ */
:root {
    --color-primary: #2b6cb0;
    --color-primary-dark: #2c5282;
    --color-primary-darker: #1e3a5f;
    --color-secondary: #4a5568;
    --color-success: #28a745;
    --color-danger: #dc3545;
    --color-warning: #ffc107;
    --color-info: #17a2b8;
    --color-light: #f7fafc;
    --color-gray: #718096;
    --color-dark: #2d3748;
    --border-radius: 0.5rem;
    --transition: all 0.3s ease;
}

/* ============================================
   HEADER CORPORATIVO
   ============================================ */
.header-corporativo {
    background: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%);
    border-radius: var(--border-radius);
    padding: 1.5rem;
    color: white;
    box-shadow: 0 4px 12px rgba(30, 58, 95, 0.2);
}

.icon-header {
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
}

.titulo-corporativo {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    margin: 0;
}

.subtitulo-corporativo {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
}

.btn-corporativo {
    background: linear-gradient(135deg, #2b6cb0 0%, #2c5282 100%);
    border: none;
    color: white;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: var(--border-radius);
    transition: var(--transition);
    box-shadow: 0 2px 8px rgba(43, 108, 176, 0.3);
}

.btn-corporativo:hover {
    background: linear-gradient(135deg, #2c5282 0%, #1e3a5f 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(43, 108, 176, 0.4);
    color: white;
}

/* ============================================
   CARD DE FILTROS
   ============================================ */
.card-filtros {
    border: none;
    border-radius: var(--border-radius);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    background: white;
}

.label-corporativo {
    color: var(--color-dark);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.input-corporativo .input-group-text {
    background: linear-gradient(135deg, #2d3748 0%, #4a5568 100%);
    border: 1px solid #2d3748;
    color: white;
}

.input-corporativo .form-control {
    border: 1px solid #cbd5e0;
    border-left: none;
    transition: var(--transition);
}

.input-corporativo .form-control:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.2rem rgba(43, 108, 176, 0.15);
}

.select-corporativo {
    border: 1px solid #cbd5e0;
    transition: var(--transition);
}

.select-corporativo:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.2rem rgba(43, 108, 176, 0.15);
}

/* ============================================
   ESTADOS DE CARGA Y ALERTAS
   ============================================ */
.loading-container {
    text-align: center;
    padding: 4rem 2rem;
}

.spinner-corporativo .spinner-border {
    width: 3rem;
    height: 3rem;
    color: var(--color-primary);
    border-width: 0.3em;
}

.loading-text {
    color: var(--color-gray);
    font-weight: 500;
    margin-top: 1rem;
}

.alert-empty {
    background: rgba(108, 117, 125, 0.08);
