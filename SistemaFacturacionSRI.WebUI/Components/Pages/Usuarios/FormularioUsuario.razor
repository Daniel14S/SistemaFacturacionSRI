@page "/usuarios/crear"
@page "/usuarios/editar/{Id:int}"
@rendermode InteractiveServer
@using SistemaFacturacionSRI.Domain.DTOs.Auth
@using SistemaFacturacionSRI.Domain.DTOs.Usuario
@using SistemaFacturacionSRI.WebUI.Services
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@attribute [Authorize(Roles = "Administrador")]
@inject IUsuarioHttpService UsuarioService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(_esEdicion ? "Editar Usuario" : "Crear Usuario")</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi @(_esEdicion ? "bi-pencil-square" : "bi-person-plus-fill") me-2"></i>
                        @(_esEdicion ? "Editar Usuario" : "Nuevo Usuario")
                    </h4>
                </div>
                <div class="card-body">
                    @if (_cargando)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2">Cargando...</p>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_errorGeneral))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Error:</strong> @_errorGeneral
                                <button type="button" class="btn-close" @onclick="@(() => _errorGeneral = null)"></button>
                            </div>
                        }

                        @if (_erroresValidacion.Any())
                        {
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                <strong>Corrija los siguientes errores:</strong>
                                <ul class="mb-0 mt-2">
                                    @foreach (var error in _erroresValidacion)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                                <button type="button" class="btn-close" @onclick="@(() => _erroresValidacion.Clear())"></button>
                            </div>
                        }

                        <EditForm Model="_modelo" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                            <DataAnnotationsValidator />
                            
                            <!-- Datos de Autenticación -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="border-bottom pb-2">
                                        <i class="bi bi-shield-lock me-2"></i>
                                        Datos de Autenticación
                                    </h5>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nombre de Usuario *</label>
                                    <InputText @bind-Value="_modelo.Username" class="form-control" placeholder="usuario123" />
                                    <ValidationMessage For="@(() => _modelo.Username)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email *</label>
                                    <InputText @bind-Value="_modelo.Email" type="email" class="form-control" placeholder="usuario@ejemplo.com" />
                                    <ValidationMessage For="@(() => _modelo.Email)" class="text-danger" />
                                </div>

                                @if (!_esEdicion)
                                {
                                    <div class="col-12">
                                        <div class="alert alert-info">
                                            <i class="bi bi-info-circle me-2"></i>
                                            <strong>Contraseña Inicial:</strong> Se usará la cédula del usuario como contraseña temporal. 
                                            El usuario deberá cambiarla en su primer inicio de sesión.
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Datos Personales -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="border-bottom pb-2">
                                        <i class="bi bi-person me-2"></i>
                                        Datos Personales
                                    </h5>
                                </div>

                                <div class="col-12 mb-3">
                                    <label class="form-label">Cédula Ecuatoriana * 
                                        @if (!_esEdicion)
                                        {
                                            <span class="text-muted">(Será la contraseña inicial)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="_modelo.Cedula" class="form-control" placeholder="1234567890" maxlength="10" inputmode="numeric" pattern="[0-9]*" @oninput="ValidarCedulaEnTiempoReal" />
                                    @if (!_esEdicion)
                                    {
                                        <small class="form-text text-muted">
                                            <i class="bi bi-shield-lock me-1"></i>
                                            10 dígitos válidos - Esta será la contraseña temporal
                                        </small>
                                    }
                                    <ValidationMessage For="@(() => _modelo.Cedula)" class="text-danger" />
                                    @if (_cedulaInvalida)
                                    {
                                        <div class="text-danger small mt-1">
                                            <i class="bi bi-x-circle me-1"></i>
                                            La cédula ecuatoriana ingresada no es válida
                                        </div>
                                    }
                                    @if (_cedulaValida)
                                    {
                                        <div class="text-success small mt-1">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Cédula válida
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Primer Nombre *</label>
                                    <InputText @bind-Value="_modelo.Nombre1" class="form-control" placeholder="Juan" />
                                    <ValidationMessage For="@(() => _modelo.Nombre1)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Segundo Nombre</label>
                                    <InputText @bind-Value="_modelo.Nombre2" class="form-control" placeholder="Carlos" />
                                    <ValidationMessage For="@(() => _modelo.Nombre2)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Primer Apellido *</label>
                                    <InputText @bind-Value="_modelo.Apellido1" class="form-control" placeholder="Pérez" />
                                    <ValidationMessage For="@(() => _modelo.Apellido1)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Segundo Apellido</label>
                                    <InputText @bind-Value="_modelo.Apellido2" class="form-control" placeholder="García" />
                                    <ValidationMessage For="@(() => _modelo.Apellido2)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Teléfono</label>
                                    <InputText @bind-Value="_modelo.Telefono" class="form-control" placeholder="0999999999" maxlength="10" inputmode="numeric" pattern="[0-9]*" />
                                    <ValidationMessage For="@(() => _modelo.Telefono)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <!-- Espacio vacío para alineación -->
                                </div>

                                <div class="col-12 mb-3">
                                    <label class="form-label">Dirección</label>
                                    <InputTextArea @bind-Value="_modelo.Direccion" class="form-control" rows="2" placeholder="Av. Principal, Quito" />
                                    <ValidationMessage For="@(() => _modelo.Direccion)" class="text-danger" />
                                </div>
                            </div>

                            <!-- Rol y Estado -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="border-bottom pb-2">
                                        <i class="bi bi-gear me-2"></i>
                                        Configuración
                                    </h5>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Rol *</label>
                                    <InputSelect @bind-Value="_modelo.RolId" class="form-select">
                                        <option value="1">Administrador</option>
                                        <option value="2">Vendedor</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _modelo.RolId)" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Estado</label>
                                    <div class="form-check form-switch mt-2">
                                        <InputCheckbox @bind-Value="_modelo.Estado" class="form-check-input" id="estadoSwitch" />
                                        <label class="form-check-label" for="estadoSwitch">
                                            @if (_modelo.Estado)
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactivo</span>
                                            }
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Botones -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button type="button" class="btn btn-secondary" @onclick="Cancelar" disabled="@_guardando">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Cancelar
                                        </button>
                                        <button type="submit" class="btn btn-primary" disabled="@_guardando">
                                            @if (_guardando)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>Guardando...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-save me-1"></i>
                                                <span>@(_esEdicion ? "Actualizar" : "Crear")</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private CrearUsuarioDto _modelo = new() { Estado = true, RolId = 1 };
    private bool _esEdicion => Id.HasValue && Id.Value > 0;
    private bool _cargando = false;
    private bool _guardando = false;
    private string? _errorGeneral;
    private List<string> _erroresValidacion = new();
    private bool _cedulaInvalida = false;
    private bool _cedulaValida = false;

    protected override async Task OnInitializedAsync()
    {
        if (_esEdicion)
        {
            await CargarUsuario();
        }
    }

    private void ValidarCedulaEnTiempoReal(ChangeEventArgs e)
    {
        var cedula = e.Value?.ToString() ?? "";
        _cedulaInvalida = false;
        _cedulaValida = false;

        if (string.IsNullOrEmpty(cedula))
            return;

        if (cedula.Length == 10)
        {
            if (ValidarCedulaEcuatoriana(cedula))
            {
                _cedulaValida = true;
            }
            else
            {
                _cedulaInvalida = true;
            }
        }
    }

    private bool ValidarCedulaEcuatoriana(string cedula)
    {
        if (string.IsNullOrEmpty(cedula) || cedula.Length != 10)
            return false;

        if (!cedula.All(char.IsDigit))
            return false;

        var digitos = cedula.Select(c => int.Parse(c.ToString())).ToArray();
        var provincia = int.Parse(cedula.Substring(0, 2));

        if (provincia < 1 || provincia > 24)
            return false;

        var coeficientes = new[] { 2, 1, 2, 1, 2, 1, 2, 1, 2 };
        var suma = 0;

        for (int i = 0; i < 9; i++)
        {
            var resultado = digitos[i] * coeficientes[i];
            if (resultado >= 10)
                resultado -= 9;
            suma += resultado;
        }

        var digitoVerificador = (10 - (suma % 10)) % 10;
        return digitoVerificador == digitos[9];
    }

    private void HandleInvalidSubmit()
    {
        _erroresValidacion.Clear();
        _erroresValidacion.Add("Por favor complete todos los campos obligatorios marcados con (*)");
        ToastService.ShowWarning("Revise los campos del formulario");
    }

    private async Task CargarUsuario()
    {
        try
        {
            _cargando = true;
            var usuario = await UsuarioService.ObtenerPorIdAsync(Id!.Value);
            
            if (usuario == null)
            {
                ToastService.ShowError("Usuario no encontrado");
                Navigation.NavigateTo("/usuarios");
                return;
            }

            _modelo = new CrearUsuarioDto
            {
                Username = usuario.Username ?? string.Empty,
                Email = usuario.Email ?? string.Empty,
                Cedula = usuario.Cedula,
                Nombre1 = usuario.Nombre1,
                Nombre2 = usuario.Nombre2,
                Apellido1 = usuario.Apellido1,
                Apellido2 = usuario.Apellido2,
                Telefono = usuario.Telefono,
                Direccion = usuario.Direccion,
                RolId = usuario.RolId,
                Estado = usuario.Estado
            };
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar usuario: {ex.Message}");
            Navigation.NavigateTo("/usuarios");
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            _guardando = true;
            _errorGeneral = null;
            _erroresValidacion.Clear();

            if (!_esEdicion && !ValidarCedulaEcuatoriana(_modelo.Cedula))
            {
                _erroresValidacion.Add("La cédula ecuatoriana no es válida");
                _cedulaInvalida = true;
                ToastService.ShowError("Cédula inválida");
                return;
            }

            if (_esEdicion)
            {
                var dto = new ActualizarUsuarioDto
                {
                    UsuarioId = Id!.Value,
                    Username = _modelo.Username,
                    Email = _modelo.Email,
                    Nombre1 = _modelo.Nombre1,
                    Nombre2 = _modelo.Nombre2,
                    Apellido1 = _modelo.Apellido1,
                    Apellido2 = _modelo.Apellido2,
                    Cedula = _modelo.Cedula,
                    Telefono = _modelo.Telefono,
                    Direccion = _modelo.Direccion
                };

                await UsuarioService.ActualizarAsync(dto);
                ToastService.ShowSuccess("Usuario actualizado exitosamente");
            }
            else
            {
                await UsuarioService.CrearAsync(_modelo);
                ToastService.ShowSuccess($"Usuario creado exitosamente. Contraseña inicial: {_modelo.Cedula}");
            }

            Navigation.NavigateTo("/usuarios");
        }
        catch (Exception ex)
        {
            var mensajeBackend = ExtraerMensajeDesdeBackend(ex.Message);
            _errorGeneral = mensajeBackend;

            if (ContieneTexto(mensajeBackend, "email") || ContieneTexto(mensajeBackend, "correo"))
            {
                _erroresValidacion.Add("El email ya está registrado en el sistema");
            }
            else if (ContieneTexto(mensajeBackend, "username"))
            {
                _erroresValidacion.Add("El nombre de usuario ya existe");
            }
            else if (ContieneTexto(mensajeBackend, "cédula") || ContieneTexto(mensajeBackend, "cedula"))
            {
                _erroresValidacion.Add("La cédula ya está registrada");
            }
            else if (ContieneTexto(mensajeBackend, "datos inválidos") || ContieneTexto(mensajeBackend, "400"))
            {
                _erroresValidacion.Add("Datos inválidos. Verifique todos los campos");
            }
            else if (!string.IsNullOrWhiteSpace(mensajeBackend))
            {
                _erroresValidacion.Add(mensajeBackend);
            }

            ToastService.ShowError("No se pudo guardar el usuario");
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/usuarios");
    }

    private static string ExtraerMensajeDesdeBackend(string? rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
        {
            return string.Empty;
        }

        var jsonStart = rawMessage.IndexOf('{');
        if (jsonStart >= 0)
        {
            var posibleJson = rawMessage.Substring(jsonStart);
            try
            {
                using var doc = JsonDocument.Parse(posibleJson);
                if (doc.RootElement.TryGetProperty("message", out var mensaje) && mensaje.ValueKind == JsonValueKind.String)
                {
                    return mensaje.GetString() ?? rawMessage;
                }
            }
            catch (JsonException)
            {
                // Ignorar, caeremos en el retorno original
            }
        }

        return rawMessage;
    }

    private static bool ContieneTexto(string origen, string texto)
    {
        return !string.IsNullOrWhiteSpace(origen) &&
               origen.Contains(texto, StringComparison.OrdinalIgnoreCase);
    }
}