@page "/cambiar-password-obligatorio"
@rendermode InteractiveServer
@using SistemaFacturacionSRI.Domain.DTOs.Usuario
@using SistemaFacturacionSRI.WebUI.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IUsuarioHttpService UsuarioService
@inject WebAuthService AuthService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Cambio de Contraseña Obligatorio</PageTitle>

<div class="cambiar-password-container">
    <div class="cambiar-password-card">
        <div class="header-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <h3>¡Atención! Primer Ingreso</h3>
            <p>Por seguridad, debes cambiar tu contraseña temporal antes de continuar.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-x-circle me-2"></i>@_errorMessage
            </div>
        }

        <EditForm Model="_modelo" OnValidSubmit="HandleCambiarPassword" autocomplete="off">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-lock me-2"></i>Contraseña Actual (Tu cédula)
                </label>
                <InputText type="password" @bind-Value="_modelo.PasswordActual" 
                           autocomplete="current-password"
                           class="form-control" placeholder="Tu cédula de 10 dígitos" />
                <ValidationMessage For="@(() => _modelo.PasswordActual)" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-shield-lock me-2"></i>Nueva Contraseña
                </label>
                <InputText type="password" @bind-Value="_modelo.NuevaPassword" 
                           autocomplete="new-password"
                           class="form-control" placeholder="Mínimo 8 caracteres" />
                <small class="form-text text-muted">
                    Debe contener: mayúscula, minúscula, número y carácter especial ($!%*?&)
                </small>
                <ValidationMessage For="@(() => _modelo.NuevaPassword)" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-check-circle me-2"></i>Confirmar Nueva Contraseña
                </label>
                <InputText type="password" @bind-Value="_modelo.ConfirmarNuevaPassword" 
                           autocomplete="new-password"
                           class="form-control" placeholder="Repite la contraseña" />
                <ValidationMessage For="@(() => _modelo.ConfirmarNuevaPassword)" class="text-danger" />
            </div>

            <div class="alert alert-warning">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Importante:</strong> No podrás usar tu cédula como nueva contraseña.
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@_guardando">
                @if (_guardando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Cambiando contraseña...</span>
                }
                else
                {
                    <i class="bi bi-shield-check me-2"></i>
                    <span>Cambiar Contraseña y Continuar</span>
                }
            </button>
        </EditForm>

        <div class="footer-note">
            <small class="text-muted">
                <i class="bi bi-lock-fill me-1"></i>
                No podrás cerrar esta ventana hasta cambiar tu contraseña
            </small>
        </div>
    </div>
</div>

<style>
    /* ==========================================================================
       CAMBIO DE CONTRASEÑA - ESTILO CORPORATIVO
       Paleta: Azules oscuros y grises profesionales
       ========================================================================== */

    .cambiar-password-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%);
        padding: 1rem;
        position: relative;
    }

    .cambiar-password-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="100" height="100" patternUnits="userSpaceOnUse"><path d="M 100 0 L 0 0 0 100" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
        opacity: 0.3;
    }

    .cambiar-password-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        max-width: 520px;
        width: 100%;
        padding: 2.5rem;
        animation: slideIn 0.4s ease-out;
        position: relative;
        z-index: 1;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .header-warning {
        text-align: center;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, rgba(255, 193, 7, 0.1) 0%, rgba(255, 193, 7, 0.05) 100%);
        border: 1px solid rgba(255, 193, 7, 0.3);
        border-radius: 0.5rem;
    }

    .header-warning i {
        font-size: 3rem;
        color: #856404;
        margin-bottom: 1rem;
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.1);
        }
    }

    .header-warning h3 {
        color: #1e3a5f;
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-size: 1.5rem;
    }

    .header-warning p {
        color: #856404;
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.95rem;
    }

    .form-label i {
        color: #2b6cb0;
    }

    .form-control {
        padding: 0.75rem 1rem;
        border: 2px solid #cbd5e0;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

    .form-control:focus {
        border-color: #2b6cb0;
        box-shadow: 0 0 0 3px rgba(43, 108, 176, 0.1);
        outline: none;
    }

    .form-text {
        color: #718096 !important;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .alert {
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.3);
        color: #721c24;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.1);
        border: 1px solid rgba(255, 193, 7, 0.3);
        color: #856404;
    }

    .text-danger {
        color: #dc3545 !important;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2b6cb0 0%, #2c5282 100%);
        border: 1px solid #2c5282;
        color: white;
        padding: 1rem;
        font-weight: 600;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
        margin-top: 1rem;
        font-size: 1rem;
    }

    .btn-primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #2c5282 0%, #1e3a5f 100%);
        border-color: #1e3a5f;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(43, 108, 176, 0.3);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .spinner-border {
        width: 1rem;
        height: 1rem;
        border-width: 0.15em;
    }

    .footer-note {
        text-align: center;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
    }

    .footer-note small {
        color: #718096;
        font-size: 0.85rem;
    }

    .footer-note i {
        color: #2b6cb0;
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .cambiar-password-card {
            padding: 1.5rem;
        }

        .header-warning {
            padding: 1rem;
        }

        .header-warning i {
            font-size: 2.5rem;
        }

        .header-warning h3 {
            font-size: 1.25rem;
        }
    }
</style>

@code {
    private CambiarPasswordDto _modelo = new();
    private bool _guardando = false;
    private string? _errorMessage;
    private int _usuarioId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUser();
            
            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var userIdClaim = user.FindFirst("sub") 
                           ?? user.FindFirst("userId") 
                           ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                _usuarioId = userId;
                _modelo.UsuarioId = userId;
            }
            else
            {
                _errorMessage = "No se pudo obtener el ID del usuario. Intenta iniciar sesión nuevamente.";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cargar: {ex.Message}";
            await Task.Delay(2000);
            Navigation.NavigateTo("/login");
        }
    }

    private async Task HandleCambiarPassword()
    {
        _guardando = true;
        _errorMessage = null;

        try
        {
            _modelo.UsuarioId = _usuarioId;
            
            await UsuarioService.CambiarPasswordAsync(_modelo);
            
            ToastService.ShowSuccess("¡Contraseña cambiada exitosamente!");
            
            await Task.Delay(2000);
            
            await AuthService.Logout();
            
            await Task.Delay(500);
            
            Navigation.NavigateTo("/login?mensaje=password-changed", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }
}