@code {
    private ConfiguracionEmpresaDto? _configuracion;
    private ActualizarConfiguracionDto _modelo = new();
    private InfoCertificadoDto? _infoCertificado;

    private bool _cargando = true;
    private bool _guardando = false;
    private string _ambienteSeleccionado = "1";
    private IBrowserFile? _archivoCertificado;
    private string _claveCertificado = string.Empty;
    private string _tipoCertificado = "PRUEBAS";
    private bool _procesandoCertificado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarConfiguracion();
            StateHasChanged();
        }
    }

    private async Task CargarConfiguracion()
    {
        _cargando = true;
        try
        {
            // Cargar configuración
            _configuracion = await ConfiguracionService.ObtenerConfiguracionAsync();

            if (_configuracion == null)
            {
                ToastService.ShowError("No se pudo cargar la configuración");
                return;
            }

            // Mapear a modelo editable
            _modelo = new ActualizarConfiguracionDto
            {
                RazonSocial = _configuracion.RazonSocial,
                NombreComercial = _configuracion.NombreComercial,
                DirMatriz = _configuracion.DirMatriz,
                DirEstablecimiento = _configuracion.DirEstablecimiento,
                ObligadoContabilidad = _configuracion.ObligadoContabilidad,
                AgenteRetencion = _configuracion.AgenteRetencion,
                Telefono = _configuracion.Telefono,
                Email = _configuracion.Email,
                InfoAdicionalDefecto = _configuracion.InfoAdicionalDefecto
            };

            _ambienteSeleccionado = _configuracion.AmbienteSRI;

            // Cargar info del certificado si existe
            if (_configuracion.TieneCertificado)
            {
                await CargarInfoCertificado();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar configuración: {ex.Message}");
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarInfoCertificado()
    {
        try
        {
            _infoCertificado = await ConfiguracionService.ObtenerInfoCertificadoAsync();

            if (_infoCertificado != null)
            {
                // Validar certificado
                var (esValido, mensaje) = await ConfiguracionService.ValidarCertificadoAsync();

                if (!esValido)
                {
                    ToastService.ShowWarning($"Advertencia del certificado: {mensaje}");
                }
                else if (_infoCertificado.DiasParaExpirar <= 30)
                {
                    ToastService.ShowWarning($"El certificado expira en {_infoCertificado.DiasParaExpirar} días");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowWarning($"No se pudo cargar información del certificado: {ex.Message}");
        }
    }

    private async Task GuardarConfiguracion()
    {
        if (_guardando) return;

        _guardando = true;
        try
        {
            // 1. Actualizar datos de la empresa
            var resultado = await ConfiguracionService.ActualizarConfiguracionAsync(_modelo);

            if (resultado == null)
            {
                ToastService.ShowError("Error al actualizar la configuración");
                return;
            }

            ToastService.ShowSuccess("Configuración actualizada correctamente");

            // 2. Cambiar ambiente si es diferente
            if (_ambienteSeleccionado != _configuracion?.AmbienteSRI)
            {
                var cambioAmbiente = await ConfiguracionService.CambiarAmbienteSRIAsync(_ambienteSeleccionado);

                if (cambioAmbiente)
                {
                    var nombreAmbiente = _ambienteSeleccionado == "1" ? "PRUEBAS" : "PRODUCCIÓN";
                    ToastService.ShowSuccess($"Ambiente cambiado a {nombreAmbiente}");
                }
                else
                {
                    ToastService.ShowError("Error al cambiar el ambiente del SRI");
                }
            }

            // 3. Recargar configuración
            await Task.Delay(1000);
            await CargarConfiguracion();
        }
        catch (HttpRequestException ex)
        {
            ToastService.ShowError($"Error de conexión: {ex.Message}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/");
    }

    private void OnCertificadoSeleccionado(InputFileChangeEventArgs e)
    {
        _archivoCertificado = e.File;
    }

    private async Task GuardarCertificadoBd()
    {
        if (_procesandoCertificado) return;

        if (_archivoCertificado == null)
        {
            ToastService.ShowWarning("Seleccione un archivo .p12/.pfx");
            return;
        }

        if (string.IsNullOrWhiteSpace(_claveCertificado))
        {
            ToastService.ShowWarning("Ingrese la clave del certificado");
            return;
        }

        _procesandoCertificado = true;
        try
        {
            await using var ms = new MemoryStream();
            await _archivoCertificado.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);

            var ok = await ConfiguracionService.SubirCertificadoAsync(ms.ToArray(), _archivoCertificado.Name, _claveCertificado, _tipoCertificado);

            if (ok)
            {
                ToastService.ShowSuccess("Certificado almacenado en la base de datos");
                _claveCertificado = string.Empty;
                _archivoCertificado = null;
                await CargarConfiguracion();
            }
            else
            {
                ToastService.ShowError("No se pudo guardar el certificado");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al subir certificado: {ex.Message}");
        }
        finally
        {
            _procesandoCertificado = false;
        }
    }

    private async Task EliminarCertificadoBd()
    {
        if (_procesandoCertificado) return;

        _procesandoCertificado = true;
        try
        {
            var ok = await ConfiguracionService.EliminarCertificadoAsync();
            if (ok)
            {
                ToastService.ShowSuccess("Certificado eliminado. Puede cargar uno nuevo.");
                await CargarConfiguracion();
            }
            else
            {
                ToastService.ShowError("No se pudo eliminar el certificado");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al eliminar certificado: {ex.Message}");
        }
        finally
        {
            _procesandoCertificado = false;
        }
    }

}