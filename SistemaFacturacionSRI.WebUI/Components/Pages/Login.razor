@page "/login"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EmptyLayout
@using SistemaFacturacionSRI.WebUI.Services
@using Microsoft.AspNetCore.WebUtilities
@inject WebAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS 

<PageTitle>Iniciar Sesión</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-shield-lock-fill"></i>
            <h3>Sistema de Facturación</h3>
            <p>Ingresa tus credenciales para continuar</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle me-2"></i>
                @ErrorMessage
                <button type="button" class="btn-close" @onclick="@(() => ErrorMessage = null)"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @SuccessMessage
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-person me-2"></i>Usuario
                </label>
                <InputText class="form-control" @bind-Value="loginModel.Username" 
                           placeholder="Ingresa tu usuario" 
                           disabled="@isLoading" />
                <ValidationMessage For="@(() => loginModel.Username)" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-lock me-2"></i>Contraseña
                </label>
                <InputText type="password" class="form-control" @bind-Value="loginModel.Password" 
                           placeholder="Ingresa tu contraseña" 
                           disabled="@isLoading" />
                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Iniciando sesión...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    <span>Ingresar</span>
                }
            </button>
        </EditForm>

        <div class="login-footer">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Usuarios por defecto: <strong>admin</strong> / <strong>vendedor</strong>
            </small>
        </div>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%);
        padding: 1rem;
    }

    .login-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        max-width: 450px;
        width: 100%;
        padding: 2.5rem;
        animation: slideIn 0.4s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .login-header i {
        font-size: 4rem;
        color: #2c5282;
        margin-bottom: 1rem;
    }

    .login-header h3 {
        margin-bottom: 0.5rem;
        color: #1e3a5f;
        font-weight: 700;
    }

    .login-header p {
        color: #64748b;
        margin-bottom: 0;
    }

    .login-form {
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control {
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 0.5rem;
        font-size: 1rem;
        transition: all 0.2s;
    }

    .form-control:focus {
        border-color: #2b6cb0;
        box-shadow: 0 0 0 0.2rem rgba(43, 108, 176, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #2b6cb0 0%, #2c5282 100%);
        border: 1px solid #2c5282;
        padding: 0.875rem;
        font-weight: 600;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #2c5282 0%, #1e3a5f 100%);
        border-color: #1e3a5f;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(30, 58, 95, 0.3);
    }

    .btn-primary:active:not(:disabled) {
        background: linear-gradient(135deg, #1e3a5f 0%, #163150 100%);
        transform: translateY(0);
        box-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.2);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .login-footer {
        text-align: center;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
    }

    .alert {
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
    }
</style>

@code {
    private LoginModel loginModel = new();
    private bool isLoading = false;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private string? returnUrl;

    protected override Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        
        // Obtener returnUrl de la query string
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var url))
        {
            returnUrl = url;
        }

        // Verificar si viene de token expirado
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("expired", out var expired))
        {
            ErrorMessage = "Tu sesión ha expirado. Por favor, inicia sesión nuevamente.";
        }

        // ⭐ MOSTRAR MENSAJE DE CAMBIO EXITOSO
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("cambioExitoso", out var cambio))
        {
            SuccessMessage = "✅ Contraseña cambiada exitosamente. Inicia sesión con tu nueva contraseña.";
        }

        return Task.CompletedTask;
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username) || 
            string.IsNullOrWhiteSpace(loginModel.Password))
        {
            ErrorMessage = "Usuario y contraseña son requeridos.";
            return;
        }

        ErrorMessage = null;
        SuccessMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthService.Login(loginModel.Username.Trim(), loginModel.Password);

            if (result == null)
            {
                ErrorMessage = "Respuesta inválida del servidor.";
                isLoading = false;
                return;
            }

            if (!result.Success)
            {
                ErrorMessage = result.Message ?? "No se pudo iniciar sesión.";
                isLoading = false;
                return;
            }

            // ⭐ DETECTAR PRIMER INGRESO
            if (result.EsPrimerIngreso)
            {
                SuccessMessage = "Primer ingreso detectado. Redirigiendo a cambio de contraseña...";
                StateHasChanged();
                
                // ⚠️ IMPORTANTE: Esperar a que el token se propague
                await Task.Delay(500);
                
                // Redirigir SIN forceLoad para mantener el estado de autenticación
                Navigation.NavigateTo("/cambiar-password-obligatorio", forceLoad: false);
                return;
            }

            // ✅ Login normal
            SuccessMessage = "¡Login exitoso! Redirigiendo...";
            StateHasChanged();
            await Task.Delay(1000);

            string targetUrl = "/";
            
            if (!string.IsNullOrEmpty(result.Role))
            {
                if (result.Role.Equals("Administrador", StringComparison.OrdinalIgnoreCase))
                {
                    targetUrl = "/admin/dashboard";
                }
                else if (result.Role.Equals("Vendedor", StringComparison.OrdinalIgnoreCase))
                {
                    targetUrl = "/vendedor/dashboard";
                }
            }
            else if (!string.IsNullOrEmpty(returnUrl))
            {
                targetUrl = returnUrl;
            }

            Navigation.NavigateTo(targetUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El usuario es requerido")]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es requerida")]
        public string Password { get; set; } = "";
    }
}