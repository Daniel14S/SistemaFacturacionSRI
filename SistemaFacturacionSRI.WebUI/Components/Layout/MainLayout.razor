@namespace SistemaFacturacionSRI.WebUI.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject WebAuthService AuthService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-3">
                        <span class="fw-semibold">
                            <i class="bi bi-person-circle me-2"></i>
                            @context.User.Identity?.Name
                        </span>
                        <span class="badge bg-primary">@GetUserRole(context)</span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Cerrar Sesión
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <span class="text-muted">No autenticado</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string GetUserRole(AuthenticationState authState)
    {
        var roleClaim = authState.User.Claims
            .FirstOrDefault(c => c.Type == "role" || c.Type == System.Security.Claims.ClaimTypes.Role);
        
        return roleClaim?.Value ?? "Sin rol";
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}