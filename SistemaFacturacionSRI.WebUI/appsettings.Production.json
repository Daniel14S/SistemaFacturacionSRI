{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "SistemaFacturacionSRI": "Information"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=SERVIDOR_PRODUCCION;Database=SistemaFacturacionSRI;User Id=usuario;Password=password;MultipleActiveResultSets=true;TrustServerCertificate=False;Encrypt=True"
  },

  "CertificadoDigital": {
    "RutaCertificado": "Infrastructure/Resources/Certificados/produccion/certificado-produccion.p12",
    "ClaveCertificado": "USAR_VARIABLE_ENTORNO",
    "TipoCertificado": "PRUEBAS",
    "ValidarVigencia": true,
    "ValidarCadenaConfianza": false
  },

  "SRI": {
    "Ambiente": "PRUEBAS",
    "AmbienteCodigo": 1,
    "TipoEmision": "NORMAL",
    "UrlRecepcion": "https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl",
    "UrlAutorizacion": "https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl",
    "TimeoutSegundos": 30,
    "ReintentoMaximo": 3,
    "DelayEntreReintentosMs": 2000,
    "UsarDelayExponencial": true,
    "EsperaAntesConsultaSegundos": 5,
    "MaximosIntentosConsulta": 10,
    "LogSoapDetallado": true,
    "ValidarCertificadoSsl": false,
    "UserAgent": "SistemaFacturacionSRI/1.0"
  },

  "JwtSettings": {
    "SecretKey": "USAR_VARIABLE_ENTORNO_O_KEY_VAULT",
    "Issuer": "SistemaFacturacionSRI",
    "Audience": "SistemaFacturacionSRI.Client",
    "ExpirationMinutes": 480
